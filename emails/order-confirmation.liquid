{% capture email_title %}Thank you for your order!{% endcapture %}
{% capture email_body %}
  {% if has_pending_payment %}
    {% if buyer_action_required %}
      You'll get a confirmation email after completing your payment.
    {% else %}
      Your payment is being processed. You'll get an email when your order is confirmed.
    {% endif %}
  {% elsif payment_charged_on_fulfillment %}
    We received your order. Your payment method will be charged when your order is ready to be fulfilled. We'll let you know when it's on its way.
  {% elsif requires_shipping %}
    {% case delivery_method %}
      {% when 'pick-up' %}
        You'll receive an email when your order is ready for pickup.
      {% when 'local' %}
        We're getting your order ready for delivery.
      {% else %}
        Clover is packing her bags! We're getting your order ready and will email you as soon as it ships.
    {% endcase %}
  {% else %}
    We've received your order and it's all set.
  {% endif %}
{% endcapture %}

{% assign has_plush = false %}
{% for line in line_items %}
  {% assign lt = line.title | downcase %}
  {% if lt contains 'plush' %}{% assign has_plush = true %}{% endif %}
{% endfor %}

<!DOCTYPE html>
<html lang="en">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="x-apple-disable-message-reformatting">
<title>{{ email_title }}</title>
<style>
  body { margin: 0; padding: 0; background: #EAFBFF; }
  a { color: #FF5757; }
  @media (max-width: 620px) {
    .px { padding-left: 20px !important; padding-right: 20px !important; }
    .h1 { font-size: 30px !important; line-height: 36px !important; }
    .btn a { display: block !important; }
    .stack { display: block !important; width: 100% !important; box-sizing: border-box !important; }
    .stack-c { text-align: center !important; padding: 18px 20px 22px !important; }
    .stack-c table { margin: 0 auto !important; }
    .stack-img { padding: 20px 20px 0 !important; }
    .stack-img img { margin: 0 auto !important; }
    .info td { display: block !important; width: 100% !important; padding: 0 0 16px !important; }
  }
</style>
</head>
<body style="margin:0;padding:0;background:#EAFBFF;">
  <div style="display:none;max-height:0;overflow:hidden;opacity:0;color:#EAFBFF;font-size:1px;line-height:1px;">
    Your order {{ order_name }} is confirmed! Plus, your free Clover activity packet is ready to download.
  </div>

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#EAFBFF;">
    <tr>
      <td align="center" style="text-align:center;padding:20px 8px 28px;">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;max-width:600px;margin:0 auto;">

          <tr>
            <td align="center" style="text-align:center;padding:6px 0 18px;">
              <a href="{{ shop.url }}" target="_blank" style="text-decoration:none;">
                <img src="https://cdn.shopify.com/s/files/1/0828/6594/6879/files/Untitled_design-63.png?v=1783471619&amp;width=360" width="180" alt="{{ shop.name }}" style="display:block;width:180px;height:auto;border:0;margin:0 auto;">
              </a>
            </td>
          </tr>

          <tr>
            <td style="text-align:left;background:#FFFFFF;border-radius:28px;overflow:hidden;box-shadow:0 12px 30px rgba(43,29,20,.08);">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">

                <!-- Sky header -->
                <tr>
                  <td bgcolor="#D6F4FF" style="background-color:#D6F4FF;border-radius:28px 28px 0 0;text-align:center;">
                    <img src="https://cdn.shopify.com/s/files/1/0828/6594/6879/files/email-sky-top.png?v=1790892516&amp;width=1200" width="600" alt="" style="display:block;width:100%;max-width:600px;height:auto;border:0;">
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                      <tr>
                        <td class="px" align="center" style="text-align:center;padding:0 40px;font-family:'Trebuchet MS',Arial,Helvetica,sans-serif;">
                          <p style="margin:0 0 14px;"><span style="display:inline-block;background:#FFFFFF;color:#518339;font-size:13px;font-weight:bold;padding:6px 14px;border-radius:99px;">&#10004; Order {{ order_name }} confirmed</span></p>
                          <h1 class="h1" style="margin:0 0 12px;font-family:'Trebuchet MS',Arial,Helvetica,sans-serif;font-size:36px;line-height:42px;color:#2B1D14;font-weight:bold;">
                            Thank you{% if customer.first_name != blank %}, {{ customer.first_name }}{% endif %}! <span style="color:#FF5757;">Cluck cluck hooray!</span>
                          </h1>
                          <p style="margin:0 0 6px;font-size:17px;line-height:27px;color:#40525A;">{{ email_body | strip }}</p>
                          {% if requires_shipping and consolidated_estimated_delivery_time %}
                            <p style="margin:6px 0 0;font-size:15px;color:#40525A;">&#128666; Estimated delivery: <strong style="color:#2B1D14;">{{ consolidated_estimated_delivery_time }}</strong></p>
                          {% endif %}
                          {% if delivery_instructions != blank %}
                            <p style="margin:6px 0 0;font-size:14px;color:#40525A;"><strong>Delivery information:</strong> {{ delivery_instructions }}</p>
                          {% endif %}
                          <img src="https://cdn.shopify.com/s/files/1/0828/6594/6879/files/Written_by_Melanie_Dieas_-_2_97c8c5fe-2952-4c29-b9c5-003b8a38daf7.png?v=1790787242&amp;width=360" width="150" alt="Clover the chicken" style="display:block;width:150px;height:auto;border:0;margin:10px auto 0;">
                        </td>
                      </tr>
                    </table>
                    <img src="https://cdn.shopify.com/s/files/1/0828/6594/6879/files/email-grass.png?v=1790892516&amp;width=1200" width="600" alt="" style="display:block;width:100%;max-width:600px;height:auto;border:0;">
                  </td>
                </tr>

                <!-- View order button -->
                {% if order_status_url %}
                <tr>
                  <td align="center" class="btn px" style="text-align:center;padding:26px 36px 4px;">
                    <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 auto;">
                      <tr>
                        <td align="center" bgcolor="#FF5757" style="text-align:center;background-color:#FF5757;border-radius:99px;">
                          <a href="{{ order_status_url }}" target="_blank" style="display:inline-block;background-color:#FF5757;border-bottom:4px solid #C62A1E;padding:16px 36px;font-family:'Trebuchet MS',Arial,Helvetica,sans-serif;font-size:17px;font-weight:bold;color:#FFFFFF;text-decoration:none;border-radius:99px;">View my order</a>
                        </td>
                      </tr>
                    </table>
                    {% if shop_app_tracking_url %}
                      <p style="margin:12px 0 0;font-family:Arial,Helvetica,sans-serif;font-size:14px;color:#5E5652;text-align:center;">or <a href="{{ shop_app_tracking_url }}" target="_blank" style="color:#518339;font-weight:bold;">track it with the Shop app</a></p>
                    {% endif %}
                  </td>
                </tr>
                {% endif %}

                <!-- Activity packet -->
                <tr>
                  <td class="px" style="padding:26px 36px 6px;font-family:'Trebuchet MS',Arial,Helvetica,sans-serif;">
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#FFFBF0;border:3px dashed #FFB800;border-radius:22px;">
                      <tr>
                        <td align="center" style="text-align:center;padding:22px 22px 24px;">
                          <p style="margin:0 0 6px;"><span style="display:inline-block;background:#FFB800;color:#2B1D14;font-size:12px;font-weight:bold;padding:5px 12px;border-radius:99px;">&#127873; A gift from Clover</span></p>
                          <p style="margin:0 0 8px;font-size:21px;line-height:27px;font-weight:bold;color:#2B1D14;">Keep the Clover fun going!</p>
                          <p style="margin:0 0 16px;font-family:Arial,Helvetica,sans-serif;font-size:15px;line-height:23px;color:#5E5652;">While you wait for your package, download your free 10-page activity packet, plus <strong>Clover's Story Chat</strong>, a bonus guide with simple questions to talk about after reading.</p>
                          <table role="presentation" class="btn" cellpadding="0" cellspacing="0" border="0" style="margin:0 auto;">
                            <tr>
                              <td align="center" bgcolor="#518339" style="text-align:center;background-color:#518339;border-radius:99px;">
                                <a href="https://cdn.shopify.com/s/files/1/0828/6594/6879/files/Clover_-_10_Page_Printable_Activity_Packet_compressed.pdf?v=1783693398" target="_blank" style="display:inline-block;background-color:#518339;border-bottom:4px solid #3A6327;padding:13px 26px;font-family:'Trebuchet MS',Arial,Helvetica,sans-serif;font-size:16px;font-weight:bold;color:#FFFFFF;text-decoration:none;border-radius:99px;">&#128397; Download the activity packet</a>
                              </td>
                            </tr>
                          </table>
                          <p style="margin:14px 0 0;font-family:Arial,Helvetica,sans-serif;font-size:14px;"><a href="https://cdn.shopify.com/s/files/1/0828/6594/6879/files/Clover_s_Story_Chat.pdf?v=1783694540" target="_blank" style="color:#FF5757;font-weight:bold;">&#128172; Download Clover's Story Chat</a></p>
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>

                <!-- Order summary -->
                <tr>
                  <td class="px" style="padding:28px 36px 6px;font-family:'Trebuchet MS',Arial,Helvetica,sans-serif;">
                    <p style="margin:0 0 12px;font-size:20px;font-weight:bold;color:#2B1D14;">Order summary</p>
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#FFF3ED;border-radius:20px;">

                      {% for line in subtotal_line_items %}
                        {% if line.groups.size == 0 %}
                        {% unless line.nested_line_child? %}
                        <tr>
                          <td width="84" valign="top" style="padding:16px 0 12px 16px;">
                            {% if line.image %}
                              <img src="{{ line | img_url: 'compact_cropped' }}" width="68" height="68" alt="" style="display:block;width:68px;height:68px;border:0;border-radius:12px;background:#FFFFFF;">
                            {% endif %}
                          </td>
                          <td valign="top" style="padding:16px 10px 12px 12px;font-family:Arial,Helvetica,sans-serif;font-size:13px;line-height:19px;color:#5E5652;">
                            <p style="margin:0 0 2px;font-family:'Trebuchet MS',Arial,Helvetica,sans-serif;font-size:16px;line-height:21px;font-weight:bold;color:#2B1D14;">{{ line.title }}</p>
                            {% if line.variant.title != 'Default Title' %}<p style="margin:0;">{{ line.variant.title }}</p>{% endif %}
                            <p style="margin:0;">Qty {{ line.quantity }}</p>
                            {% for property in line.properties %}
                              {% assign first_char = property.first | slice: 0 %}
                              {% if property.last != blank and first_char != '_' %}
                                <p style="margin:2px 0 0;"><strong style="color:#2B1D14;">{{ property.first }}:</strong> {{ property.last }}</p>
                              {% endif %}
                            {% endfor %}
                            {% if line.selling_plan_allocation %}<p style="margin:2px 0 0;">{{ line.selling_plan_allocation.selling_plan.name }}</p>{% endif %}
                            {% if line.nested_line_parent? %}
                              {% for child_line in line.nested_lines %}
                                <p style="margin:2px 0 0;">+ {{ child_line.title }} &times; {{ child_line.quantity }}</p>
                              {% endfor %}
                            {% endif %}
                            {% for discount_allocation in line.discount_allocations %}
                              {% if discount_allocation.discount_application.target_selection != 'all' %}
                                <p style="margin:2px 0 0;color:#518339;font-weight:bold;">&#127991; {{ discount_allocation.discount_application.title | upcase }} (-{{ discount_allocation.amount | money }})</p>
                              {% endif %}
                            {% endfor %}
                          </td>
                          <td valign="top" align="right" style="text-align:right;padding:16px 16px 12px 0;font-family:'Trebuchet MS',Arial,Helvetica,sans-serif;font-size:15px;font-weight:bold;color:#2B1D14;white-space:nowrap;">
                            {% if line.original_line_price != line.final_line_price %}<span style="display:block;font-size:13px;font-weight:normal;color:#8A817C;text-decoration:line-through;">{{ line.original_line_price | money }}</span>{% endif %}
                            {% if line.final_line_price > 0 %}{{ line.final_line_price | money }}{% else %}Free{% endif %}
                          </td>
                        </tr>
                        {% endunless %}
                        {% endif %}
                      {% endfor %}

                      {% for line_item_group in line_item_groups %}
                        {% assign group_final = 0 %}
                        {% assign group_original = 0 %}
                        {% assign group_parent = nil %}
                        {% if line_item_group.deliverable? %}
                          {% assign group_parent = line_item_group.parent_sales_line_item %}
                          {% assign group_final = group_parent.final_line_price %}
                          {% assign group_original = group_parent.original_line_price %}
                        {% endif %}
                        {% for component in line_item_group.components %}
                          {% assign group_final = group_final | plus: component.final_line_price %}
                          {% assign group_original = group_original | plus: component.original_line_price %}
                        {% endfor %}
                        <tr>
                          <td width="84" valign="top" style="padding:16px 0 12px 16px;">
                            {% if group_parent and group_parent.image %}
                              <img src="{{ group_parent | img_url: 'compact_cropped' }}" width="68" height="68" alt="" style="display:block;width:68px;height:68px;border:0;border-radius:12px;background:#FFFFFF;">
                            {% elsif line_item_group.image %}
                              <img src="{{ line_item_group | img_url: 'compact_cropped' }}" width="68" height="68" alt="" style="display:block;width:68px;height:68px;border:0;border-radius:12px;background:#FFFFFF;">
                            {% endif %}
                          </td>
                          <td valign="top" style="padding:16px 10px 12px 12px;font-family:Arial,Helvetica,sans-serif;font-size:13px;line-height:19px;color:#5E5652;">
                            <p style="margin:0 0 2px;font-family:'Trebuchet MS',Arial,Helvetica,sans-serif;font-size:16px;line-height:21px;font-weight:bold;color:#2B1D14;">{{ line_item_group.display_title }}</p>
                            <p style="margin:0;">Qty {{ line_item_group.quantity }}</p>
                            {% for component in line_item_group.components %}
                              {% if component.product.title %}{% assign component_title = component.product.title %}{% else %}{% assign component_title = component.title %}{% endif %}
                              <p style="margin:2px 0 0;">&#10003; {{ component.quantity }} &times; {{ component_title }}</p>
                            {% endfor %}
                          </td>
                          <td valign="top" align="right" style="text-align:right;padding:16px 16px 12px 0;font-family:'Trebuchet MS',Arial,Helvetica,sans-serif;font-size:15px;font-weight:bold;color:#2B1D14;white-space:nowrap;">
                            {% if group_original != group_final %}<span style="display:block;font-size:13px;font-weight:normal;color:#8A817C;text-decoration:line-through;">{{ group_original | money }}</span>{% endif %}
                            {% if group_final > 0 %}{{ group_final | money }}{% else %}Free{% endif %}
                          </td>
                        </tr>
                      {% endfor %}

                      <tr>
                        <td colspan="3" style="padding:4px 16px 0;"><div style="border-top:2px dashed #F6C9B3;line-height:0;font-size:0;">&nbsp;</div></td>
                      </tr>

                      {% assign total_order_discount_amount = 0 %}
                      {% for discount_application in discount_applications %}
                        {% if discount_application.target_selection == 'all' and discount_application.target_type == 'line_item' %}
                          {% assign total_order_discount_amount = total_order_discount_amount | plus: discount_application.total_allocated_amount %}
                        {% endif %}
                      {% endfor %}

                      {% assign ship_total = shipping_price %}
                      {% if shipping_methods.size > 0 %}
                        {% assign ship_total = 0 %}
                        {% for method in shipping_methods %}
                          {% assign ship_total = ship_total | plus: method.price_with_discounts %}
                        {% endfor %}
                      {% endif %}

                      <tr>
                        <td colspan="3" style="padding:12px 16px 16px;">
                          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:20px;color:#5E5652;">
                            <tr>
                              <td style="padding:3px 0;">Subtotal</td>
                              <td align="right" style="text-align:right;padding:3px 0;color:#2B1D14;">{{ subtotal_price | plus: total_order_discount_amount | money }}</td>
                            </tr>
                            {% for discount_application in discount_applications %}
                              {% if discount_application.target_selection == 'all' and discount_application.target_type != 'shipping_line' %}
                              <tr>
                                <td style="padding:3px 0;color:#518339;">&#127991; {{ discount_application.title }}</td>
                                <td align="right" style="text-align:right;padding:3px 0;color:#518339;">-{{ discount_application.total_allocated_amount | money }}</td>
                              </tr>
                              {% endif %}
                            {% endfor %}
                            {% if requires_shipping %}
                            <tr>
                              <td style="padding:3px 0;">{% if delivery_method == 'pick-up' %}Pickup{% else %}Shipping{% endif %}</td>
                              <td align="right" style="text-align:right;padding:3px 0;color:#2B1D14;">{% if ship_total > 0 %}{{ ship_total | money }}{% else %}<strong style="color:#518339;">Free</strong>{% endif %}</td>
                            </tr>
                            {% endif %}
                            {% if total_duties %}
                            <tr>
                              <td style="padding:3px 0;">Duties</td>
                              <td align="right" style="text-align:right;padding:3px 0;color:#2B1D14;">{{ total_duties | money }}</td>
                            </tr>
                            {% endif %}
                            <tr>
                              <td style="padding:3px 0;">Taxes</td>
                              <td align="right" style="text-align:right;padding:3px 0;color:#2B1D14;">{{ tax_price | money }}</td>
                            </tr>
                            {% if total_tip and total_tip > 0 %}
                            <tr>
                              <td style="padding:3px 0;">Tip</td>
                              <td align="right" style="text-align:right;padding:3px 0;color:#2B1D14;">{{ total_tip | money }}</td>
                            </tr>
                            {% endif %}
                            <tr>
                              <td style="padding:10px 0 0;font-family:'Trebuchet MS',Arial,Helvetica,sans-serif;font-size:18px;font-weight:bold;color:#2B1D14;">Total</td>
                              <td align="right" style="text-align:right;padding:10px 0 0;font-family:'Trebuchet MS',Arial,Helvetica,sans-serif;font-size:18px;font-weight:bold;color:#2B1D14;">{{ total_price | money_with_currency }}</td>
                            </tr>
                            {% if total_discounts > 0 %}
                            <tr>
                              <td colspan="2" align="right" style="text-align:right;padding:4px 0 0;"><span style="display:inline-block;background:#E3F4D8;color:#518339;font-weight:bold;font-size:13px;padding:4px 10px;border-radius:99px;">You saved {{ total_discounts | money }}!</span></td>
                            </tr>
                            {% endif %}
                          </table>
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>

                <!-- Customer info -->
                <tr>
                  <td class="px" style="padding:24px 36px 4px;">
                    <table role="presentation" class="info" width="100%" cellpadding="0" cellspacing="0" border="0" style="font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:21px;color:#5E5652;">
                      <tr>
                        {% if requires_shipping and shipping_address %}
                        <td width="50%" valign="top" style="padding:0 12px 0 0;">
                          <p style="margin:0 0 4px;font-family:'Trebuchet MS',Arial,Helvetica,sans-serif;font-size:15px;font-weight:bold;color:#2B1D14;">&#127968; Shipping to</p>
                          {{ shipping_address | format_address }}
                          {% if shipping_method %}<p style="margin:6px 0 0;"><strong style="color:#2B1D14;">Method:</strong> {{ shipping_method.title }}</p>{% endif %}
                        </td>
                        {% endif %}
                        {% if billing_address %}
                        <td width="50%" valign="top" style="padding:0;">
                          <p style="margin:0 0 4px;font-family:'Trebuchet MS',Arial,Helvetica,sans-serif;font-size:15px;font-weight:bold;color:#2B1D14;">&#129534; Billing address</p>
                          {{ billing_address | format_address }}
                        </td>
                        {% endif %}
                      </tr>
                    </table>
                  </td>
                </tr>

                <!-- Plush cross-sell (hidden if they already bought a plush) -->
                {% unless has_plush %}
                <tr>
                  <td class="px" style="padding:24px 36px 6px;font-family:'Trebuchet MS',Arial,Helvetica,sans-serif;">
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#F1FAEA;border-radius:24px;">
                      <tr>
                        <td class="stack stack-img" width="38%" valign="middle" style="padding:20px 0 20px 20px;">
                          <a href="{{ shop.url }}/products/clover-plush" target="_blank"><img src="https://cdn.shopify.com/s/files/1/0828/6594/6879/files/Untitleddesign-84_1a8d20d3-9079-498e-943b-ca6c509e5a6c.png?v=1785417791&amp;width=500" width="180" alt="Clover chicken plush" style="display:block;width:100%;max-width:180px;height:auto;border:0;border-radius:18px;"></a>
                        </td>
                        <td class="stack stack-c" valign="middle" style="padding:20px 22px 20px 18px;font-family:Arial,Helvetica,sans-serif;font-size:15px;line-height:22px;color:#5E5652;">
                          <p style="margin:0 0 4px;font-family:'Trebuchet MS',Arial,Helvetica,sans-serif;font-size:13px;font-weight:bold;letter-spacing:1px;color:#518339;">NEW &middot; LIMITED STOCK</p>
                          <p style="margin:0 0 6px;font-family:'Trebuchet MS',Arial,Helvetica,sans-serif;font-size:20px;line-height:25px;font-weight:bold;color:#2B1D14;">Give Clover a cuddle</p>
                          <p style="margin:0 0 14px;">Our soft 8-inch Clover plush is the perfect storytime buddy, and a sweet gift for the holidays.</p>
                          <table role="presentation" class="btn" cellpadding="0" cellspacing="0" border="0">
                            <tr>
                              <td align="center" bgcolor="#518339" style="text-align:center;background-color:#518339;border-radius:99px;">
                                <a href="{{ shop.url }}/products/clover-plush" target="_blank" style="display:inline-block;background-color:#518339;border-bottom:4px solid #3A6327;padding:12px 24px;font-family:'Trebuchet MS',Arial,Helvetica,sans-serif;font-size:15px;font-weight:bold;color:#FFFFFF;text-decoration:none;border-radius:99px;">Meet the plush</a>
                              </td>
                            </tr>
                          </table>
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>
                {% endunless %}

                <!-- Sign-off -->
                <tr>
                  <td class="px" align="center" style="text-align:center;padding:26px 44px 36px;font-family:Arial,Helvetica,sans-serif;">
                    <p style="margin:0 0 4px;font-size:15px;line-height:23px;color:#5E5652;">Thank you for bringing Clover home. It truly means the world to me. Tag us when she arrives, I'd love to see your little reader with her!</p>
                    <img src="https://cdn.shopify.com/s/files/1/0828/6594/6879/files/email-signature.png?v=1790891320&amp;width=440" width="200" alt="Melanie" style="display:block;width:200px;max-width:70%;height:auto;border:0;margin:10px auto 2px;">
                    <p style="margin:0;font-size:13px;color:#8A817C;">Author of <em>Clover, the Brave Chicken</em></p>
                  </td>
                </tr>

              </table>
            </td>
          </tr>

          <tr>
            <td align="center" style="text-align:center;padding:22px 20px 0;font-family:Arial,Helvetica,sans-serif;font-size:12px;line-height:19px;color:#6F8791;">
