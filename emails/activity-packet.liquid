<!doctype html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="x-apple-disable-message-reformatting">
<title>Your free Clover activity packet</title>
<!--
  Clover Stories: "Your activity packet is here" email
  Paste into Shopify Messaging > Create email > Custom (code your own).
  Links to the files in Shopify > Content > Files. If you replace a PDF, update its link below.
-->
<style>
  body { margin: 0; padding: 0; background: #EAFBFF; }
  a { color: #FF5757; }
  @media (max-width: 620px) {
    .wrap { width: 100% !important; }
    .px { padding-left: 22px !important; padding-right: 22px !important; }
    .h1 { font-size: 30px !important; line-height: 36px !important; }
    .stack { display: block !important; width: 100% !important; box-sizing: border-box !important; }
    .stack-img { padding: 26px 0 14px 0 !important; text-align: center !important; }
    .stack-c { text-align: center !important; padding-top: 0 !important; }
    .stack-c table { margin-left: auto !important; margin-right: auto !important; }
    .btn a { display: block !important; }
    .nbpad { padding: 0 16px 0 62px !important; }
    .pg { padding-left: 3px !important; padding-right: 3px !important; }
  }
</style>
</head>
<body style="margin:0;padding:0;background:#EAFBFF;">
  <!-- inbox preview text -->
  <div style="display:none;max-height:0;overflow:hidden;opacity:0;color:#EAFBFF;font-size:1px;line-height:1px;">
    Your 10-page Clover activity packet and the bonus Story Chat are ready to print. Grab your crayons!
  </div>

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#EAFBFF;">
    <tr>
      <td align="center" style="text-align:center;padding:20px 8px 28px;">
        <table role="presentation" class="wrap" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;max-width:600px;margin:0 auto;">

          <!-- Logo -->
          <tr>
            <td align="center" style="text-align:center;padding:6px 0 18px;">
              <a href="{{ shop.url }}" target="_blank" style="text-decoration:none;">
                <img src="https://cdn.shopify.com/s/files/1/0828/6594/6879/files/Untitled_design-63.png?v=1783471619&width=360" width="180" alt="Clover Stories" style="display:block;width:180px;height:auto;border:0;margin:0 auto;">
              </a>
            </td>
          </tr>

          <!-- Main card -->
          <tr>
            <td style="background:#FFFFFF;border-radius:28px;overflow:hidden;box-shadow:0 12px 30px rgba(43,29,20,.08);">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">

                <!-- Notebook header (matches the Activities page) -->
                <tr>
                  <td background="https://cdn.shopify.com/s/files/1/0828/6594/6879/files/email-notebook-1x.png?v=1790891052" bgcolor="#FFFEF7" style="background:#FFFEF7 url('https://cdn.shopify.com/s/files/1/0828/6594/6879/files/email-notebook-1x.png?v=1790891052') repeat left top;border-radius:28px 28px 0 0;">
                    <img src="https://cdn.shopify.com/s/files/1/0828/6594/6879/files/email-art-top.png?v=1790891023&width=1200" width="600" alt="" style="display:block;width:100%;max-width:600px;height:auto;border:0;">
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                      <tr>
                        <td class="nbpad" align="center" style="text-align:center;padding:0 34px 0 72px;font-family:'Trebuchet MS',Arial,Helvetica,sans-serif;">
                          <p style="margin:0 0 14px;"><span style="display:inline-block;background:#FFF1C7;color:#8A5A00;font-size:13px;font-weight:bold;padding:6px 14px;border-radius:99px;">&#9999;&#65039; Free printable &middot; 10 pages</span></p>
                          <h1 class="h1" style="margin:0 0 12px;font-family:'Trebuchet MS',Arial,Helvetica,sans-serif;font-size:34px;line-height:40px;color:#2B1D14;font-weight:bold;">
                            {%- if customer.first_name != blank -%}{{ customer.first_name }}, your{%- else -%}Your{%- endif %} <span style="color:#FF5757;">free</span> activity packet is here!
                          </h1>
                          <p style="margin:0;font-size:17px;line-height:27px;color:#5E5652;">
                            Thanks for joining Clover's Club! Coloring, mazes, tracing, counting and more: 10 pages of farmyard fun starring Clover and her friends.
                          </p>
                          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:22px 0 4px;">
                            <tr>
                            <td class="pg" width="33%" align="center" valign="top" style="text-align:center;padding:14px 5px 0;">
                              <a href="https://cdn.shopify.com/s/files/1/0828/6594/6879/files/Clover_-_10_Page_Printable_Activity_Packet_compressed.pdf?v=1787919708" target="_blank" style="text-decoration:none;">
                                <img src="https://cdn.shopify.com/s/files/1/0828/6594/6879/files/Clover_-_10_Page_Printable_Activity_Packet.png?v=1783692110&width=300" width="128" alt="Coloring page" style="display:block;width:100%;max-width:128px;height:auto;border:5px solid #FFFFFF;border-radius:4px;box-shadow:0 10px 16px rgba(0,0,0,.18);margin:0 auto;">
                              </a>
                              <p style="margin:10px 0 0;"><span style="display:inline-block;background:#FFFFFF;border:2px solid #F2E8E2;border-radius:99px;padding:3px 10px;font-family:'Trebuchet MS',Arial,Helvetica,sans-serif;font-size:12px;font-weight:bold;color:#2B1D14;">Coloring</span></p>
                            </td>
                            <td class="pg" width="33%" align="center" valign="top" style="text-align:center;padding:0px 5px 0;">
                              <a href="https://cdn.shopify.com/s/files/1/0828/6594/6879/files/Clover_-_10_Page_Printable_Activity_Packet_compressed.pdf?v=1787919708" target="_blank" style="text-decoration:none;">
                                <img src="https://cdn.shopify.com/s/files/1/0828/6594/6879/files/Clover_-_10_Page_Printable_Activity_Packet-2.png?v=1783692384&width=300" width="128" alt="Maze page" style="display:block;width:100%;max-width:128px;height:auto;border:5px solid #FFFFFF;border-radius:4px;box-shadow:0 10px 16px rgba(0,0,0,.18);margin:0 auto;">
                              </a>
                              <p style="margin:10px 0 0;"><span style="display:inline-block;background:#FFFFFF;border:2px solid #F2E8E2;border-radius:99px;padding:3px 10px;font-family:'Trebuchet MS',Arial,Helvetica,sans-serif;font-size:12px;font-weight:bold;color:#2B1D14;">Maze</span></p>
                            </td>
                            <td class="pg" width="33%" align="center" valign="top" style="text-align:center;padding:14px 5px 0;">
                              <a href="https://cdn.shopify.com/s/files/1/0828/6594/6879/files/Clover_-_10_Page_Printable_Activity_Packet_compressed.pdf?v=1787919708" target="_blank" style="text-decoration:none;">
                                <img src="https://cdn.shopify.com/s/files/1/0828/6594/6879/files/Clover_-_10_Page_Printable_Activity_Packet-7.png?v=1783692382&width=300" width="128" alt="Counting page" style="display:block;width:100%;max-width:128px;height:auto;border:5px solid #FFFFFF;border-radius:4px;box-shadow:0 10px 16px rgba(0,0,0,.18);margin:0 auto;">
                              </a>
                              <p style="margin:10px 0 0;"><span style="display:inline-block;background:#FFFFFF;border:2px solid #F2E8E2;border-radius:99px;padding:3px 10px;font-family:'Trebuchet MS',Arial,Helvetica,sans-serif;font-size:12px;font-weight:bold;color:#2B1D14;">Counting</span></p>
                            </td>
                            </tr>
                          </table>
                          <table role="presentation" cellpadding="0" cellspacing="0" border="0" class="btn" style="margin:22px auto 0;">
                            <tr>
                              <td align="center" bgcolor="#FF5757" style="text-align:center;background-color:#FF5757;border-radius:99px;">
                                <a href="https://cdn.shopify.com/s/files/1/0828/6594/6879/files/Clover_-_10_Page_Printable_Activity_Packet_compressed.pdf?v=1787919708" target="_blank" style="display:inline-block;background-color:#FF5757;padding:17px 34px;font-family:'Trebuchet MS',Arial,Helvetica,sans-serif;font-size:18px;font-weight:bold;color:#FFFFFF;text-decoration:none;border-radius:99px;border-bottom:4px solid #C62A1E;">Download my activity packet</a>
                              </td>
                            </tr>
                          </table>
                          <p style="margin:12px 0 0;font-family:Arial,Helvetica,sans-serif;font-size:13px;color:#8A817C;">10-page printable PDF &middot; print as many copies as you like</p>
                        </td>
                      </tr>
                    </table>
                    <img src="https://cdn.shopify.com/s/files/1/0828/6594/6879/files/email-art-bottom.png?v=1790891023&width=1200" width="600" alt="" style="display:block;width:100%;max-width:600px;height:auto;border:0;">
                  </td>
                </tr>

                <!-- Bonus card -->
                <tr>
                  <td class="px" style="padding:28px 36px 8px;">
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#FFFBF0;border:3px dashed #FFB800;border-radius:22px;">
                      <tr>
                        <td style="padding:22px 24px;font-family:'Trebuchet MS',Arial,Helvetica,sans-serif;">
                          <p style="margin:0 0 8px;"><span style="display:inline-block;background:#FFB800;color:#2B1D14;font-size:11px;font-weight:bold;letter-spacing:1px;padding:4px 10px;border-radius:99px;">BONUS</span></p>
                          <p style="margin:0 0 6px;font-size:21px;font-weight:bold;color:#2B1D14;">Clover's Story Chat &#128172;</p>
                          <p style="margin:0 0 16px;font-family:Arial,Helvetica,sans-serif;font-size:15px;line-height:23px;color:#5E5652;">A little parent &amp; teacher discussion sheet with kid-friendly questions to help young readers talk about Clover's story, feelings, bravery and what makes them unique.</p>
                          <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                            <tr>
                              <td align="center" bgcolor="#518339" style="text-align:center;background-color:#518339;border-radius:99px;">
                                <a href="https://cdn.shopify.com/s/files/1/0828/6594/6879/files/Clover_s_Story_Chat.pdf?v=1787919710" target="_blank" style="display:inline-block;background-color:#518339;border-bottom:4px solid #3A6427;padding:12px 26px;font-family:'Trebuchet MS',Arial,Helvetica,sans-serif;font-size:15px;font-weight:bold;color:#FFFFFF;text-decoration:none;border-radius:99px;">Download the Story Chat</a>
                              </td>
                            </tr>
                          </table>
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>

                <!-- Tips -->
                <tr>
                  <td class="px" style="padding:28px 44px 6px;font-family:'Trebuchet MS',Arial,Helvetica,sans-serif;">
                    <p style="margin:0 0 14px;font-size:20px;font-weight:bold;color:#2B1D14;text-align:center;">Tips for farmyard fun</p>
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="font-family:Arial,Helvetica,sans-serif;font-size:15px;line-height:22px;color:#5E5652;">
                      <tr>
                        <td width="44" valign="top" style="padding:0 0 12px;font-size:22px;">&#128424;&#65039;</td>
                        <td valign="top" style="padding:2px 0 12px;"><strong style="color:#2B1D14;">Print at home or school.</strong> Regular letter paper works great. Print extras for siblings and friends!</td>
                      </tr>
                      <tr>
                        <td width="44" valign="top" style="padding:0 0 12px;font-size:22px;">&#128218;</td>
                        <td valign="top" style="padding:2px 0 12px;"><strong style="color:#2B1D14;">Pair it with storytime.</strong> Read <em>Clover, the Brave Chicken</em> together, then find the farm friends on each page.</td>
                      </tr>
                      <tr>
                        <td width="44" valign="top" style="padding:0 0 12px;font-size:22px;">&#127942;</td>
                        <td valign="top" style="padding:2px 0 12px;"><strong style="color:#2B1D14;">Celebrate the finish.</strong> Don't miss the reading certificate. It's made for proud little readers.</td>
                      </tr>
                    </table>
                  </td>
                </tr>

                <!-- Book promo -->
                <tr>
                  <td class="px" style="padding:18px 36px 36px;">
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#FFF3ED;border-radius:22px;">
                      <tr>
                        <td class="stack stack-img" width="170" valign="middle" style="padding:22px 0 22px 22px;">
                          <a href="{{ shop.url }}/products/clover-the-brave-chicken" target="_blank">
                            <img src="https://cdn.shopify.com/s/files/1/0828/6594/6879/files/clovercoverupdated_merged_2.jpg?v=1783625495&width=320" width="150" alt="Clover, the Brave Chicken book cover" style="display:inline-block;width:150px;height:auto;border:0;border-radius:10px;">
                          </a>
                        </td>
                        <td class="stack px stack-c" valign="middle" style="padding:22px 24px 22px 20px;font-family:'Trebuchet MS',Arial,Helvetica,sans-serif;">
                          <p style="margin:0 0 4px;font-size:15px;color:#FFB800;letter-spacing:2px;">&#9733;&#9733;&#9733;&#9733;&#9733;</p>
                          <p style="margin:0 0 6px;font-size:20px;line-height:25px;font-weight:bold;color:#2B1D14;">Read the story that started it all</p>
                          <p style="margin:0 0 14px;font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:21px;color:#5E5652;"><em>Clover, the Brave Chicken</em> is a rhyming farm adventure about being brave enough to be yourself. Premium hardcover, free shipping, and Melanie can sign it for your little one.</p>
                          <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                            <tr>
                              <td align="center" bgcolor="#FF5757" style="text-align:center;background-color:#FF5757;border-radius:99px;">
                                <a href="{{ shop.url }}/products/clover-the-brave-chicken" target="_blank" style="display:inline-block;background-color:#FF5757;border-bottom:4px solid #C62A1E;padding:12px 24px;font-family:'Trebuchet MS',Arial,Helvetica,sans-serif;font-size:15px;font-weight:bold;color:#FFFFFF;text-decoration:none;border-radius:99px;">Get the book &rarr;</a>
                              </td>
                            </tr>
                          </table>
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>

                <!-- Sign-off -->
                <tr>
                  <td class="px" align="center" style="padding:0 44px 36px;text-align:center;font-family:'Trebuchet MS',Arial,Helvetica,sans-serif;">
                    <img src="https://cdn.shopify.com/s/files/1/0828/6594/6879/files/Written_by_Melanie_Dieas_-_2_97c8c5fe-2952-4c29-b9c5-003b8a38daf7.png?v=1790787242&width=240" width="110" alt="" style="display:block;width:110px;height:auto;border:0;margin:0 auto 10px;">
                    <p style="margin:0 0 4px;font-family:Arial,Helvetica,sans-serif;font-size:15px;line-height:23px;color:#5E5652;">Happy coloring! I'd love to see your little one's creations. Just reply to this email.</p>
                    <img src="https://cdn.shopify.com/s/files/1/0828/6594/6879/files/email-signature.png?v=1790891320&width=440" width="200" alt="Melanie" style="display:block;width:200px;max-width:70%;height:auto;border:0;margin:10px auto 2px;">
                    <p style="margin:0;font-family:Arial,Helvetica,sans-serif;font-size:13px;color:#8A817C;">Author of <em>Clover, the Brave Chicken</em></p>
                  </td>
                </tr>

              </table>
            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td align="center" style="padding:22px 20px 0;text-align:center;font-family:Arial,Helvetica,sans-serif;font-size:12px;line-height:19px;color:#6F8791;">
              <p style="margin:0 0 6px;text-align:center;"><a href="{{ shop.url }}" target="_blank" style="color:#518339;font-weight:bold;text-decoration:none;">cloverstories.com</a></p>
              <p style="margin:0 0 6px;text-align:center;">You're getting this because you joined Clover's Club at {{ shop.name }}.</p>
              <p style="margin:0;text-align:center;">{{ unsubscribe_link }}</p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
  {{ open_tracking_block }}
</body>
</html>
