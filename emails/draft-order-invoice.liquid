{% capture email_title %}{% if payment_terms %}Review and confirm to complete your order{% else %}Complete your purchase{% endif %}{% endcapture %}
{% capture email_body %}
  {% if item_count > 1 %}
    These items will be reserved for you until {{ reserve_inventory_until | date: format: 'date_at_time' }}.
  {% else %}
    This item will be reserved for you until {{ reserve_inventory_until | date: format: 'date_at_time' }}.
  {% endif %}
{% endcapture %}

<!DOCTYPE html>
<html lang="en">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="x-apple-disable-message-reformatting">
<title>{{ email_title }}</title>
<style>
  body { margin: 0; padding: 0; background: #EAFBFF; }
  a { color: #FF5757; }
  @media (max-width: 620px) {
    .px { padding-left: 20px !important; padding-right: 20px !important; }
    .h1 { font-size: 30px !important; line-height: 36px !important; }
    .btn a { display: block !important; }
    .stack { display: block !important; width: 100% !important; box-sizing: border-box !important; }
    .stack-c { text-align: center !important; padding: 18px 20px 22px !important; }
    .stack-c table { margin: 0 auto !important; }
    .stack-img { padding: 20px 20px 0 !important; }
    .stack-img img { margin: 0 auto !important; }
    .info td { display: block !important; width: 100% !important; padding: 0 0 16px !important; }
  }
</style>
</head>
<body style="margin:0;padding:0;background:#EAFBFF;">
  <div style="display:none;max-height:0;overflow:hidden;opacity:0;color:#EAFBFF;font-size:1px;line-height:1px;">
    Your invoice {{ name }} from {{ shop.name }} is ready. Review your order and complete your purchase.
  </div>

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#EAFBFF;">
    <tr>
      <td align="center" style="text-align:center;padding:20px 8px 28px;">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;max-width:600px;margin:0 auto;">

          <tr>
            <td align="center" style="text-align:center;padding:6px 0 18px;">
              <a href="{{ shop.url }}" target="_blank" style="text-decoration:none;">
                <img src="https://cdn.shopify.com/s/files/1/0828/6594/6879/files/Untitled_design-63.png?v=1783471619&amp;width=360" width="180" alt="{{ shop.name }}" style="display:block;width:180px;height:auto;border:0;margin:0 auto;">
              </a>
            </td>
          </tr>

          <tr>
            <td style="text-align:left;background:#FFFFFF;border-radius:28px;overflow:hidden;box-shadow:0 12px 30px rgba(43,29,20,.08);">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">

                <!-- Sky header -->
                <tr>
                  <td bgcolor="#D6F4FF" style="background-color:#D6F4FF;border-radius:28px 28px 0 0;text-align:center;">
                    <img src="https://cdn.shopify.com/s/files/1/0828/6594/6879/files/email-sky-top.png?v=1790892516&amp;width=1200" width="600" alt="" style="display:block;width:100%;max-width:600px;height:auto;border:0;">
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                      <tr>
                        <td class="px" align="center" style="text-align:center;padding:0 40px;font-family:'Trebuchet MS',Arial,Helvetica,sans-serif;">
                          <p style="margin:0 0 14px;"><span style="display:inline-block;background:#FFFFFF;color:#518339;font-size:13px;font-weight:bold;padding:6px 14px;border-radius:99px;">&#128203; Invoice {{ name }}</span></p>
                          <h1 class="h1" style="margin:0 0 12px;font-family:'Trebuchet MS',Arial,Helvetica,sans-serif;font-size:36px;line-height:42px;color:#2B1D14;font-weight:bold;">
                            {% if customer.first_name != blank %}Hi {{ customer.first_name }}, your{% else %}Your{% endif %} <span style="color:#FF5757;">invoice</span> is ready
                          </h1>
                          {% if custom_message != blank %}
                            <p style="margin:0 0 6px;font-size:17px;line-height:27px;color:#40525A;">{{ custom_message }}</p>
                          {% else %}
                            <p style="margin:0 0 6px;font-size:17px;line-height:27px;color:#40525A;">{% if payment_terms %}Please review the details below and confirm your order.{% else %}Please review the details below and complete your purchase.{% endif %}</p>
                          {% endif %}
                          {% if reserve_inventory_until %}
                            <p style="margin:6px 0 0;font-size:15px;color:#40525A;">&#9203; {{ email_body | strip }}</p>
                          {% endif %}
                          <img src="https://cdn.shopify.com/s/files/1/0828/6594/6879/files/Written_by_Melanie_Dieas_-_2_97c8c5fe-2952-4c29-b9c5-003b8a38daf7.png?v=1790787242&amp;width=360" width="150" alt="Clover the chicken" style="display:block;width:150px;height:auto;border:0;margin:10px auto 0;">
                        </td>
                      </tr>
                    </table>
                    <img src="https://cdn.shopify.com/s/files/1/0828/6594/6879/files/email-grass.png?v=1790892516&amp;width=1200" width="600" alt="" style="display:block;width:100%;max-width:600px;height:auto;border:0;">
                  </td>
                </tr>

                <!-- Pay button -->
                <tr>
                  <td align="center" class="btn px" style="text-align:center;padding:26px 36px 4px;">
                    <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 auto;">
                      <tr>
                        <td align="center" bgcolor="#FF5757" style="text-align:center;background-color:#FF5757;border-radius:99px;">
                          <a href="{{ invoice_url }}" target="_blank" style="display:inline-block;background-color:#FF5757;border-bottom:4px solid #C62A1E;padding:16px 36px;font-family:'Trebuchet MS',Arial,Helvetica,sans-serif;font-size:17px;font-weight:bold;color:#FFFFFF;text-decoration:none;border-radius:99px;">{% if payment_terms %}Confirm order{% else %}Complete your purchase{% endif %}</a>
                        </td>
                      </tr>
                    </table>
                    <p style="margin:12px 0 0;font-family:Arial,Helvetica,sans-serif;font-size:13px;color:#8A817C;text-align:center;">&#128274; Secure checkout</p>
                  </td>
                </tr>

                <!-- Order summary -->
                <tr>
                  <td class="px" style="padding:28px 36px 6px;font-family:'Trebuchet MS',Arial,Helvetica,sans-serif;">
                    <p style="margin:0 0 12px;font-size:20px;font-weight:bold;color:#2B1D14;">Order summary</p>
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#FFF3ED;border-radius:20px;">

                      {% for line in subtotal_line_items %}
                        {% unless line.nested_line_child? %}
                        <tr>
                          <td width="84" valign="top" style="padding:16px 0 12px 16px;">
                            {% if line.image %}
                              <img src="{{ line | img_url: 'compact_cropped' }}" width="68" height="68" alt="" style="display:block;width:68px;height:68px;border:0;border-radius:12px;background:#FFFFFF;">
                            {% endif %}
                          </td>
                          <td valign="top" style="padding:16px 10px 12px 12px;font-family:Arial,Helvetica,sans-serif;font-size:13px;line-height:19px;color:#5E5652;">
                            <p style="margin:0 0 2px;font-family:'Trebuchet MS',Arial,Helvetica,sans-serif;font-size:16px;line-height:21px;font-weight:bold;color:#2B1D14;">{{ line.title }}</p>
                            {% if line.variant.title != 'Default Title' %}<p style="margin:0;">{{ line.variant.title }}</p>{% endif %}
                            <p style="margin:0;">Qty {{ line.quantity }}</p>
                            {% for property in line.properties %}
                              {% assign first_char = property.first | slice: 0 %}
                              {% if property.last != blank and first_char != '_' %}
                                <p style="margin:2px 0 0;"><strong style="color:#2B1D14;">{{ property.first }}:</strong> {{ property.last }}</p>
                              {% endif %}
                            {% endfor %}
                            {% if line.selling_plan_allocation %}<p style="margin:2px 0 0;">{{ line.selling_plan_allocation.selling_plan.name }}</p>{% endif %}
                            {% for child_line in line.bundle_components %}
                              <p style="margin:2px 0 0;">&#10003; {{ child_line.quantity }} &times; {% if child_line.product.title %}{{ child_line.product.title }}{% else %}{{ child_line.title }}{% endif %}</p>
                            {% endfor %}
                            {% if line.nested_line_parent? %}
                              {% for child_line in line.nested_lines %}
                                <p style="margin:2px 0 0;">+ {{ child_line.title }} &times; {{ child_line.quantity }}</p>
                              {% endfor %}
                            {% endif %}
                            {% for discount_allocation in line.discount_allocations %}
                              {% if discount_allocation.discount_application.target_selection != 'all' %}
                                <p style="margin:2px 0 0;color:#518339;font-weight:bold;">&#127991; {{ discount_allocation.discount_application.title | upcase }} (-{{ discount_allocation.amount | money }})</p>
                              {% endif %}
                            {% endfor %}
                          </td>
                          <td valign="top" align="right" style="text-align:right;padding:16px 16px 12px 0;font-family:'Trebuchet MS',Arial,Helvetica,sans-serif;font-size:15px;font-weight:bold;color:#2B1D14;white-space:nowrap;">
                            {% if line.original_line_price != line.final_line_price %}<span style="display:block;font-size:13px;font-weight:normal;color:#8A817C;text-decoration:line-through;">{{ line.original_line_price | money }}</span>{% endif %}
                            {% if line.final_line_price > 0 %}{{ line.final_line_price | money }}{% else %}Free{% endif %}
                          </td>
                        </tr>
                        {% endunless %}
                      {% endfor %}

                      <tr>
                        <td colspan="3" style="padding:4px 16px 0;"><div style="border-top:2px dashed #F6C9B3;line-height:0;font-size:0;">&nbsp;</div></td>
                      </tr>

                      {% assign total_order_discount_amount = 0 %}
                      {% for discount_application in discount_applications %}
                        {% if discount_application.target_selection == 'all' and discount_application.target_type == 'line_item' %}
                          {% assign total_order_discount_amount = total_order_discount_amount | plus: discount_application.total_allocated_amount %}
                        {% endif %}
                      {% endfor %}

                      {% assign ship_total = shipping_price %}
                      {% for discount_application in discount_applications %}
                        {% if discount_application.target_type == 'shipping_line' %}
                          {% assign ship_total = ship_total | minus: discount_application.total_allocated_amount %}
                        {% endif %}
                      {% endfor %}

                      <tr>
                        <td colspan="3" style="padding:12px 16px 16px;">
                          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:20px;color:#5E5652;">
                            <tr>
                              <td style="padding:3px 0;">Subtotal</td>
                              <td align="right" style="text-align:right;padding:3px 0;color:#2B1D14;">{{ subtotal_price | plus: total_order_discount_amount | money }}</td>
                            </tr>
                            {% for discount_application in discount_applications %}
                              {% if discount_application.target_selection == 'all' and discount_application.target_type != 'shipping_line' %}
                              <tr>
                                <td style="padding:3px 0;color:#518339;">&#127991; {{ discount_application.title }}</td>
                                <td align="right" style="text-align:right;padding:3px 0;color:#518339;">-{{ discount_application.total_allocated_amount | money }}</td>
                              </tr>
                              {% endif %}
                            {% endfor %}
                            {% if shipping_method or shipping_price > 0 %}
                            <tr>
                              <td style="padding:3px 0;">{% if delivery_method == 'pick-up' %}Pickup{% else %}Shipping{% endif %}</td>
                              <td align="right" style="text-align:right;padding:3px 0;color:#2B1D14;">{% if ship_total > 0 %}{{ ship_total | money }}{% else %}<strong style="color:#518339;">Free</strong>{% endif %}</td>
                            </tr>
                            {% endif %}
                            {% if total_duties %}
                            <tr>
                              <td style="padding:3px 0;">Duties</td>
                              <td align="right" style="text-align:right;padding:3px 0;color:#2B1D14;">{{ total_duties | money }}</td>
                            </tr>
                            {% endif %}
                            <tr>
                              <td style="padding:3px 0;">Estimated taxes</td>
                              <td align="right" style="text-align:right;padding:3px 0;color:#2B1D14;">{{ tax_price | money }}</td>
                            </tr>
                            {% if total_tip and total_tip > 0 %}
                            <tr>
                              <td style="padding:3px 0;">Tip</td>
                              <td align="right" style="text-align:right;padding:3px 0;color:#2B1D14;">{{ total_tip | money }}</td>
                            </tr>
                            {% endif %}
                            {% if payment_terms %}
                              {% assign next_amount_due = total_price | minus: amount_due_now %}
                              <tr>
                                <td style="padding:10px 0 0;font-family:'Trebuchet MS',Arial,Helvetica,sans-serif;font-size:18px;font-weight:bold;color:#2B1D14;">Total due today</td>
                                <td align="right" style="text-align:right;padding:10px 0 0;font-family:'Trebuchet MS',Arial,Helvetica,sans-serif;font-size:18px;font-weight:bold;color:#2B1D14;">{{ amount_due_now | money_with_currency }}</td>
                              </tr>
                              <tr>
                                <td style="padding:4px 0 0;">{% if payment_terms.type == 'receipt' %}Due on receipt{% elsif payment_terms.type == 'fulfillment' %}Due on fulfillment{% else %}Due {{ payment_terms.next_payment.due_at | date: format: 'date' }}{% endif %}</td>
                                <td align="right" style="text-align:right;padding:4px 0 0;color:#2B1D14;font-weight:bold;">{{ next_amount_due | money_with_currency }}</td>
                              </tr>
                            {% else %}
                              <tr>
                                <td style="padding:10px 0 0;font-family:'Trebuchet MS',Arial,Helvetica,sans-serif;font-size:18px;font-weight:bold;color:#2B1D14;">Total</td>
                                <td align="right" style="text-align:right;padding:10px 0 0;font-family:'Trebuchet MS',Arial,Helvetica,sans-serif;font-size:18px;font-weight:bold;color:#2B1D14;">{{ total_price | money_with_currency }}</td>
                              </tr>
                            {% endif %}
                            {% if total_discounts > 0 %}
                            <tr>
                              <td colspan="2" align="right" style="text-align:right;padding:4px 0 0;"><span style="display:inline-block;background:#E3F4D8;color:#518339;font-weight:bold;font-size:13px;padding:4px 10px;border-radius:99px;">You saved {{ total_discounts | money }}!</span></td>
                            </tr>
                            {% endif %}
                          </table>
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>

                <!-- Customer info -->
                <tr>
                  <td class="px" style="padding:24px 36px 4px;">
                    <table role="presentation" class="info" width="100%" cellpadding="0" cellspacing="0" border="0" style="font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:21px;color:#5E5652;">
                      <tr>
                        {% if shipping_address %}
                        <td width="50%" valign="top" style="padding:0 12px 0 0;">
                          <p style="margin:0 0 4px;font-family:'Trebuchet MS',Arial,Helvetica,sans-serif;font-size:15px;font-weight:bold;color:#2B1D14;">&#127968; Shipping to</p>
                          {{ shipping_address | format_address }}
                          {% if shipping_method %}<p style="margin:6px 0 0;"><strong style="color:#2B1D14;">Method:</strong> {% if local_pickup %}Local pickup - {% endif %}{{ shipping_method.title }}</p>{% endif %}
                        </td>
                        {% endif %}
                        {% if billing_address %}
                        <td width="50%" valign="top" style="padding:0;">
                          <p style="margin:0 0 4px;font-family:'Trebuchet MS',Arial,Helvetica,sans-serif;font-size:15px;font-weight:bold;color:#2B1D14;">&#129534; Billing address</p>
                          {{ billing_address | format_address }}
                        </td>
                        {% endif %}
                      </tr>
                      {% if company_location or payment_terms %}
                      <tr>
                        {% if company_location %}
                        <td width="50%" valign="top" style="padding:16px 12px 0 0;">
                          <p style="margin:0 0 4px;font-family:'Trebuchet MS',Arial,Helvetica,sans-serif;font-size:15px;font-weight:bold;color:#2B1D14;">&#127970; Location</p>
                          <p style="margin:0;">{{ company_location.name }}</p>
                        </td>
                        {% endif %}
                        {% if payment_terms %}
                        <td width="50%" valign="top" style="padding:16px 0 0;">
                          <p style="margin:0 0 4px;font-family:'Trebuchet MS',Arial,Helvetica,sans-serif;font-size:15px;font-weight:bold;color:#2B1D14;">&#128179; Payment terms</p>
                          <p style="margin:0;">{{ payment_terms.translated_name }}{% unless payment_terms.type == 'receipt' or payment_terms.type == 'fulfillment' %}: Due {{ payment_terms.next_payment.due_at | date: format: 'date' }}{% endunless %}</p>
                        </td>
                        {% endif %}
                      </tr>
                      {% endif %}
                    </table>
                  </td>
                </tr>

                <!-- Sign-off -->
                <tr>
                  <td class="px" align="center" style="text-align:center;padding:26px 44px 36px;font-family:Arial,Helvetica,sans-serif;">
                    <p style="margin:0 0 4px;font-size:15px;line-height:23px;color:#5E5652;">Thank you so much for your order. If you have any questions about this invoice, just reply to this email and I'll help.</p>
                    <img src="https://cdn.shopify.com/s/files/1/0828/6594/6879/files/email-signature.png?v=1790891320&amp;width=440" width="200" alt="Melanie" style="display:block;width:200px;max-width:70%;height:auto;border:0;margin:10px auto 2px;">
                    <p style="margin:0;font-size:13px;color:#8A817C;">Author of <em>Clover, the Brave Chicken</em></p>
                  </td>
                </tr>

              </table>
            </td>
          </tr>

          <tr>
            <td align="center" style="text-align:center;padding:22px 20px 0;font-family:Arial,Helvetica,sans-serif;font-size:12px;line-height:19px;color:#6F8791;">
              <p style="margin:0 0 6px;text-align:center;">Questions? Just reply to this email or write to <a href="mailto:{{ shop.email }}" style="color:#518339;font-weight:bold;">{{ shop.email }}</a></p>
              <p style="margin:0;text-align:center;"><a href="{{ shop.url }}" target="_blank" style="color:#518339;font-weight:bold;text-decoration:none;">cloverstories.com</a></p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>
