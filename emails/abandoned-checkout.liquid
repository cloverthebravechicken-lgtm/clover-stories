<!doctype html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="x-apple-disable-message-reformatting">
<title>Clover is waiting for you</title>
<style>
  body { margin: 0; padding: 0; background: #EAFBFF; }
  a { color: #FF5757; }
  @media (max-width: 620px) {
    .px { padding-left: 22px !important; padding-right: 22px !important; }
    .h1 { font-size: 30px !important; line-height: 36px !important; }
    .btn a { display: block !important; }
    .stack { display: block !important; width: 100% !important; box-sizing: border-box !important; text-align: center !important; }
    .trust td { display: block !important; width: 100% !important; padding: 6px 0 !important; }
  }
</style>
</head>
<body style="margin:0;padding:0;background:#EAFBFF;">
  <div style="display:none;max-height:0;overflow:hidden;opacity:0;color:#EAFBFF;font-size:1px;line-height:1px;">
    Your copy of Clover, the Brave Chicken is still in your basket. Free shipping and a free activity packet are waiting too!
  </div>

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#EAFBFF;">
    <tr>
      <td align="center" style="text-align:center;padding:20px 8px 28px;">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;max-width:600px;margin:0 auto;">

          <!-- Logo -->
          <tr>
            <td align="center" style="text-align:center;padding:6px 0 18px;">
              <a href="{{ shop.url }}" target="_blank" style="text-decoration:none;">
                <img src="https://cdn.shopify.com/s/files/1/0828/6594/6879/files/Untitled_design-63.png?v=1783471619&width=360" width="180" alt="Clover Stories" style="display:block;width:180px;height:auto;border:0;margin:0 auto;">
              </a>
            </td>
          </tr>

          <!-- Main card -->
          <tr>
            <td style="text-align:left;background:#FFFFFF;border-radius:28px;overflow:hidden;box-shadow:0 12px 30px rgba(43,29,20,.08);">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">

                <!-- Sky header with Clover on the grass -->
                <tr>
                  <td bgcolor="#D6F4FF" style="background-color:#D6F4FF;border-radius:28px 28px 0 0;text-align:center;">
                    <img src="https://cdn.shopify.com/s/files/1/0828/6594/6879/files/email-sky-top.png?v=1790892516&width=1200" width="600" alt="" style="display:block;width:100%;max-width:600px;height:auto;border:0;">
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                      <tr>
                        <td class="px" align="center" style="text-align:center;padding:0 40px;font-family:'Trebuchet MS',Arial,Helvetica,sans-serif;">
                          <p style="margin:0 0 14px;"><span style="display:inline-block;background:#FFFFFF;color:#518339;font-size:13px;font-weight:bold;padding:6px 14px;border-radius:99px;">&#129530; Still in your basket</span></p>
                          <h1 class="h1" style="margin:0 0 12px;font-family:'Trebuchet MS',Arial,Helvetica,sans-serif;font-size:34px;line-height:40px;color:#2B1D14;font-weight:bold;">
                            {%- if customer.first_name != blank -%}{{ customer.first_name }}, Clover{%- else -%}Clover{%- endif %} is <span style="color:#FF5757;">waiting</span> for you!
                          </h1>
                          <p style="margin:0 0 6px;font-size:17px;line-height:27px;color:#40525A;">
                            We saved your basket so it's ready whenever you are. Bedtime stories are better with a brave little chicken.
                          </p>
                          <img src="https://cdn.shopify.com/s/files/1/0828/6594/6879/files/Written_by_Melanie_Dieas_-_2_97c8c5fe-2952-4c29-b9c5-003b8a38daf7.png?v=1790787242&width=360" width="150" alt="Clover the chicken" style="display:block;width:150px;height:auto;border:0;margin:6px auto 0;">
                        </td>
                      </tr>
                    </table>
                    <img src="https://cdn.shopify.com/s/files/1/0828/6594/6879/files/email-grass.png?v=1790892516&width=1200" width="600" alt="" style="display:block;width:100%;max-width:600px;height:auto;border:0;">
                  </td>
                </tr>

                <!-- Basket -->
                <tr>
                  <td class="px" style="padding:28px 36px 6px;font-family:'Trebuchet MS',Arial,Helvetica,sans-serif;">
                    <p style="margin:0 0 12px;font-size:20px;font-weight:bold;color:#2B1D14;">Your basket</p>
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#FFF3ED;border-radius:20px;">
                      {%- for line in line_items -%}
                      <tr>
                        <td width="96" valign="middle" style="padding:16px 0 16px 16px;">
                          {%- if line.image -%}
                            <img src="{{ line | img_url: 'compact_cropped' }}" width="80" alt="{{ line.title | escape }}" style="display:block;width:80px;height:auto;border:0;border-radius:10px;">
                          {%- endif -%}
                        </td>
                        <td valign="middle" style="padding:16px 12px;font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:20px;color:#5E5652;">
                          <strong style="font-family:'Trebuchet MS',Arial,Helvetica,sans-serif;font-size:16px;color:#2B1D14;">{{ line.product.title | default: line.title }}</strong>
                          {%- if line.variant.title != blank and line.variant.title != 'Default Title' -%}<br>{{ line.variant.title }}{%- endif -%}
                          {%- for p in line.properties -%}
                            {%- assign first_char = p.first | slice: 0 -%}
                            {%- if p.last != blank and first_char != '_' -%}<br><span style="color:#518339;font-weight:bold;">&#9997;&#65039; {{ p.first }}: {{ p.last }}</span>{%- endif -%}
                          {%- endfor -%}
                          <br>Qty {{ line.quantity }}
                        </td>
                        <td align="right" valign="middle" style="text-align:right;padding:16px 16px 16px 0;font-family:'Trebuchet MS',Arial,Helvetica,sans-serif;font-size:16px;font-weight:bold;color:#2B1D14;white-space:nowrap;">
                          {{ line.final_line_price | money }}
                        </td>
                      </tr>
                      {%- endfor -%}
                      <tr>
                        <td colspan="3" style="padding:0 16px;"><div style="border-top:2px dashed #F6C9B3;line-height:0;font-size:0;">&nbsp;</div></td>
                      </tr>
                      <tr>
                        <td colspan="2" style="padding:14px 12px 16px 16px;font-family:Arial,Helvetica,sans-serif;font-size:15px;color:#5E5652;">Subtotal <span style="color:#518339;font-weight:bold;">&middot; free shipping</span></td>
                        <td align="right" style="text-align:right;padding:14px 16px 16px 0;font-family:'Trebuchet MS',Arial,Helvetica,sans-serif;font-size:18px;font-weight:bold;color:#2B1D14;white-space:nowrap;">{{ subtotal_price | money }}</td>
                      </tr>
                    </table>
                  </td>
                </tr>

                <!-- Main button -->
                <tr>
                  <td align="center" class="btn px" style="text-align:center;padding:24px 36px 6px;">
                    <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 auto;">
                      <tr>
                        <td align="center" bgcolor="#FF5757" style="text-align:center;background-color:#FF5757;border-radius:99px;">
                          <a href="{{ url }}" target="_blank" style="display:inline-block;background-color:#FF5757;border-bottom:4px solid #C62A1E;padding:17px 38px;font-family:'Trebuchet MS',Arial,Helvetica,sans-serif;font-size:18px;font-weight:bold;color:#FFFFFF;text-decoration:none;border-radius:99px;">Return to my basket</a>
                        </td>
                      </tr>
                    </table>
                    <p style="margin:12px 0 0;font-family:Arial,Helvetica,sans-serif;font-size:13px;color:#8A817C;text-align:center;">&#128274; Secure checkout &middot; takes less than a minute</p>
                  </td>
                </tr>

                <!-- Perks -->
                <tr>
                  <td class="px" style="padding:24px 36px 4px;">
                    <table role="presentation" class="trust" width="100%" cellpadding="0" cellspacing="0" border="0" style="font-family:'Trebuchet MS',Arial,Helvetica,sans-serif;font-size:14px;font-weight:bold;color:#2B1D14;">
                      <tr>
                        <td width="33%" align="center" style="text-align:center;padding:0 4px;"><span style="display:inline-block;background:#E3F4D8;color:#518339;padding:8px 12px;border-radius:99px;">&#128230; Free shipping</span></td>
                        <td width="34%" align="center" style="text-align:center;padding:0 4px;"><span style="display:inline-block;background:#FFF1C7;color:#8A5A00;padding:8px 12px;border-radius:99px;">&#128397; Free activities</span></td>
                        <td width="33%" align="center" style="text-align:center;padding:0 4px;"><span style="display:inline-block;background:#FFE0D6;color:#C62A1E;padding:8px 12px;border-radius:99px;">&#128218; Hardcover</span></td>
                      </tr>
                    </table>
                  </td>
                </tr>

                <!-- Reviews -->
                <tr>
                  <td class="px" style="padding:26px 36px 8px;font-family:'Trebuchet MS',Arial,Helvetica,sans-serif;">
                    <p style="margin:0 0 12px;font-size:20px;font-weight:bold;color:#2B1D14;text-align:center;">The critics are clucking</p>
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#FFFBF0;border:3px dashed #FFB800;border-radius:22px;">
                      <tr>
                        <td style="padding:20px 22px;">
                          <p style="margin:0 0 6px;font-size:15px;color:#FFB800;letter-spacing:2px;">&#9733;&#9733;&#9733;&#9733;&#9733;</p>
                          <p style="margin:0 0 6px;font-family:Arial,Helvetica,sans-serif;font-size:15px;line-height:23px;color:#5E5652;">&ldquo;A charming farmyard story about finding the courage to embrace who you are.&rdquo;</p>
                          <p style="margin:0 0 16px;font-size:14px;font-weight:bold;color:#518339;">&mdash; Kirkus Reviews</p>
                          <p style="margin:0 0 6px;font-size:15px;color:#FFB800;letter-spacing:2px;">&#9733;&#9733;&#9733;&#9733;&#9733;</p>
                          <p style="margin:0 0 6px;font-family:Arial,Helvetica,sans-serif;font-size:15px;line-height:23px;color:#5E5652;">&ldquo;Great gift!! My grandchildren absolutely love it!!!&rdquo;</p>
                          <p style="margin:0;font-size:14px;font-weight:bold;color:#518339;">&mdash; Happy reader</p>
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>

                <!-- Signed copy nudge -->
                <tr>
                  <td class="px" style="padding:20px 36px 6px;font-family:Arial,Helvetica,sans-serif;font-size:15px;line-height:23px;color:#5E5652;text-align:center;">
                    <strong style="font-family:'Trebuchet MS',Arial,Helvetica,sans-serif;color:#2B1D14;">Making it a gift?</strong> Add a personal inscription and Melanie will sign it just for your little one.
                  </td>
                </tr>

                <!-- Sign-off -->
                <tr>
                  <td class="px" align="center" style="text-align:center;padding:18px 44px 36px;font-family:Arial,Helvetica,sans-serif;">
                    <p style="margin:0 0 4px;font-size:15px;line-height:23px;color:#5E5652;">Questions? Just reply to this email. I read every one.</p>
                    <img src="https://cdn.shopify.com/s/files/1/0828/6594/6879/files/email-signature.png?v=1790891320&width=440" width="200" alt="Melanie" style="display:block;width:200px;max-width:70%;height:auto;border:0;margin:10px auto 2px;">
                    <p style="margin:0;font-size:13px;color:#8A817C;">Author of <em>Clover, the Brave Chicken</em></p>
                  </td>
                </tr>

              </table>
            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td align="center" style="text-align:center;padding:22px 20px 0;font-family:Arial,Helvetica,sans-serif;font-size:12px;line-height:19px;color:#6F8791;">
              <p style="margin:0 0 6px;text-align:center;"><a href="{{ shop.url }}" target="_blank" style="color:#518339;font-weight:bold;text-decoration:none;">cloverstories.com</a></p>
              <p style="margin:0;text-align:center;">You're getting this because you started a checkout at {{ shop.name }}.</p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>
