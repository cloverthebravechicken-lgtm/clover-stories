{% capture email_title %}Your order is out for delivery{% endcapture %}
{% capture email_body %}Your package is on the delivery truck and will be at your door soon. Keep an eye out for a brave little chicken!{% endcapture %}

<!DOCTYPE html>
<html lang="en">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="x-apple-disable-message-reformatting">
<title>{{ email_title }}</title>
<style>
  body { margin: 0; padding: 0; background: #EAFBFF; }
  a { color: #FF5757; }
  @media (max-width: 620px) {
    .px { padding-left: 20px !important; padding-right: 20px !important; }
    .h1 { font-size: 30px !important; line-height: 36px !important; }
    .btn a { display: block !important; }
  }
</style>
</head>
<body style="margin:0;padding:0;background:#EAFBFF;">
  <div style="display:none;max-height:0;overflow:hidden;opacity:0;color:#EAFBFF;font-size:1px;line-height:1px;">
    Clover is almost there! Your order {{ order_name }} is out for delivery today.
  </div>

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#EAFBFF;">
    <tr>
      <td align="center" style="text-align:center;padding:20px 8px 28px;">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;max-width:600px;margin:0 auto;">

          <tr>
            <td align="center" style="text-align:center;padding:6px 0 18px;">
              <a href="{{ shop.url }}" target="_blank" style="text-decoration:none;">
                <img src="https://cdn.shopify.com/s/files/1/0828/6594/6879/files/Untitled_design-63.png?v=1783471619&amp;width=360" width="180" alt="{{ shop.name }}" style="display:block;width:180px;height:auto;border:0;margin:0 auto;">
              </a>
            </td>
          </tr>

          <tr>
            <td style="text-align:left;background:#FFFFFF;border-radius:28px;overflow:hidden;box-shadow:0 12px 30px rgba(43,29,20,.08);">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">

                <!-- Sky header -->
                <tr>
                  <td bgcolor="#D6F4FF" style="background-color:#D6F4FF;border-radius:28px 28px 0 0;text-align:center;">
                    <img src="https://cdn.shopify.com/s/files/1/0828/6594/6879/files/email-sky-top.png?v=1790892516&amp;width=1200" width="600" alt="" style="display:block;width:100%;max-width:600px;height:auto;border:0;">
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                      <tr>
                        <td class="px" align="center" style="text-align:center;padding:0 40px;font-family:'Trebuchet MS',Arial,Helvetica,sans-serif;">
                          <p style="margin:0 0 14px;"><span style="display:inline-block;background:#FFFFFF;color:#518339;font-size:13px;font-weight:bold;padding:6px 14px;border-radius:99px;">&#128666; Order {{ order_name }} out for delivery</span></p>
                          <h1 class="h1" style="margin:0 0 12px;font-family:'Trebuchet MS',Arial,Helvetica,sans-serif;font-size:36px;line-height:42px;color:#2B1D14;font-weight:bold;">
                            {% if customer.first_name != blank %}{{ customer.first_name }}, Clover{% else %}Clover{% endif %} is <span style="color:#FF5757;">almost there!</span>
                          </h1>
                          <p style="margin:0 0 6px;font-size:17px;line-height:27px;color:#40525A;">{{ email_body }}</p>
                          <img src="https://cdn.shopify.com/s/files/1/0828/6594/6879/files/Written_by_Melanie_Dieas_-_2_97c8c5fe-2952-4c29-b9c5-003b8a38daf7.png?v=1790787242&amp;width=360" width="150" alt="Clover the chicken" style="display:block;width:150px;height:auto;border:0;margin:10px auto 0;">
                        </td>
                      </tr>
                    </table>
                    <img src="https://cdn.shopify.com/s/files/1/0828/6594/6879/files/email-grass.png?v=1790892516&amp;width=1200" width="600" alt="" style="display:block;width:100%;max-width:600px;height:auto;border:0;">
                  </td>
                </tr>

                <!-- View order -->
                {% if order_status_url %}
                <tr>
                  <td align="center" class="btn px" style="text-align:center;padding:26px 36px 4px;">
                    <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 auto;">
                      <tr>
                        <td align="center" bgcolor="#FF5757" style="text-align:center;background-color:#FF5757;border-radius:99px;">
                          <a href="{{ order_status_url }}" target="_blank" style="display:inline-block;background-color:#FF5757;border-bottom:4px solid #C62A1E;padding:16px 36px;font-family:'Trebuchet MS',Arial,Helvetica,sans-serif;font-size:17px;font-weight:bold;color:#FFFFFF;text-decoration:none;border-radius:99px;">View my order</a>
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>
                {% endif %}

                <!-- Items in delivery -->
                <tr>
                  <td class="px" style="padding:26px 36px 6px;font-family:'Trebuchet MS',Arial,Helvetica,sans-serif;">
                    <p style="margin:0 0 12px;font-size:20px;font-weight:bold;color:#2B1D14;">Arriving today</p>
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border:2px solid #FFE0D6;border-radius:20px;">
                      {% for line in fulfillment.fulfillment_line_items %}
                        {% unless line.line_item.nested_line_child? %}
                        {% if line.line_item.title %}{% assign line_title = line.line_item.title %}{% else %}{% assign line_title = line.line_item.product.title %}{% endif %}
                        <tr>
                          <td width="84" valign="top" style="padding:14px 0 10px 14px;">
                            {% if line.line_item.image %}
                              <img src="{{ line.line_item | img_url: 'compact_cropped' }}" width="68" height="68" alt="" style="display:block;width:68px;height:68px;border:0;border-radius:12px;background:#FFF3ED;">
                            {% endif %}
                          </td>
                          <td valign="middle" style="padding:14px 16px 10px 12px;font-family:Arial,Helvetica,sans-serif;font-size:13px;line-height:19px;color:#5E5652;">
                            <p style="margin:0 0 2px;font-family:'Trebuchet MS',Arial,Helvetica,sans-serif;font-size:16px;line-height:21px;font-weight:bold;color:#2B1D14;">{{ line_title }}</p>
                            {% if line.line_item.variant.title != 'Default Title' %}<p style="margin:0;">{{ line.line_item.variant.title }}</p>{% endif %}
                            <p style="margin:0;">Qty {% if line.quantity < line.line_item.quantity %}{{ line.quantity }} of {{ line.line_item.quantity }}{% else %}{{ line.quantity }}{% endif %}</p>
                            {% for group in line.line_item.groups %}
                              <p style="margin:2px 0 0;">Part of: {{ group.display_title }}</p>
                            {% endfor %}
                            {% for property in line.line_item.properties %}
                              {% assign first_char = property.first | slice: 0 %}
                              {% if property.last != blank and first_char != '_' %}
                                <p style="margin:2px 0 0;"><strong style="color:#2B1D14;">{{ property.first }}:</strong> {{ property.last }}</p>
                              {% endif %}
                            {% endfor %}
                            {% if line.line_item.nested_line_parent? %}
                              {% for child_line in line.line_item.nested_lines %}
                                <p style="margin:2px 0 0;">+ {{ child_line.title }} &times; {{ child_line.quantity }}</p>
                              {% endfor %}
                            {% endif %}
                          </td>
                        </tr>
                        {% endunless %}
                      {% endfor %}
                      <tr><td colspan="2" style="padding:0;font-size:0;line-height:4px;">&nbsp;</td></tr>
                    </table>
                  </td>
                </tr>

                <!-- Get ready for storytime -->
                <tr>
                  <td class="px" style="padding:26px 36px 6px;font-family:'Trebuchet MS',Arial,Helvetica,sans-serif;">
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#FFFBF0;border:3px dashed #FFB800;border-radius:22px;">
                      <tr>
                        <td style="padding:22px 24px 24px;">
                          <p style="margin:0 0 12px;text-align:center;font-size:20px;font-weight:bold;color:#2B1D14;">Get ready for storytime! &#127775;</p>
                          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="font-family:Arial,Helvetica,sans-serif;font-size:15px;line-height:22px;color:#5E5652;">
                            <tr>
                              <td width="34" valign="top" style="padding:0 0 10px;font-size:20px;">&#128424;</td>
                              <td valign="top" style="padding:0 0 10px;"><strong style="color:#2B1D14;">Print the activity packet</strong> so it's ready when Clover arrives. <a href="https://cdn.shopify.com/s/files/1/0828/6594/6879/files/Clover_-_10_Page_Printable_Activity_Packet_compressed.pdf?v=1783693398" target="_blank" style="color:#FF5757;font-weight:bold;">Download it here.</a></td>
                            </tr>
                            <tr>
                              <td width="34" valign="top" style="padding:0;font-size:20px;">&#128172;</td>
                              <td valign="top" style="padding:0;"><strong style="color:#2B1D14;">Talk about it after reading</strong> with <a href="https://cdn.shopify.com/s/files/1/0828/6594/6879/files/Clover_s_Story_Chat.pdf?v=1783694540" target="_blank" style="color:#FF5757;font-weight:bold;">Clover's Story Chat</a>, simple questions for little readers.</td>
                            </tr>
                          </table>
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>

                <!-- Sign-off -->
                <tr>
                  <td class="px" align="center" style="text-align:center;padding:26px 44px 36px;font-family:Arial,Helvetica,sans-serif;">
                    <p style="margin:0 0 4px;font-size:15px;line-height:23px;color:#5E5652;">I can't wait for your little reader to meet Clover. Happy reading!</p>
                    <img src="https://cdn.shopify.com/s/files/1/0828/6594/6879/files/email-signature.png?v=1790891320&amp;width=440" width="200" alt="Melanie" style="display:block;width:200px;max-width:70%;height:auto;border:0;margin:10px auto 2px;">
                    <p style="margin:0;font-size:13px;color:#8A817C;">Author of <em>Clover, the Brave Chicken</em></p>
                  </td>
                </tr>

              </table>
            </td>
          </tr>

          <tr>
            <td align="center" style="text-align:center;padding:22px 20px 0;font-family:Arial,Helvetica,sans-serif;font-size:12px;line-height:19px;color:#6F8791;">
              <p style="margin:0 0 6px;text-align:center;">Questions? Just reply to this email or write to <a href="mailto:{{ shop.email }}" style="color:#518339;font-weight:bold;">{{ shop.email }}</a><!-- shopify-shop-marketplace-footer --></p>
              <p style="margin:0;text-align:center;"><a href="{{ shop.url }}" target="_blank" style="color:#518339;font-weight:bold;text-decoration:none;">cloverstories.com</a></p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>
