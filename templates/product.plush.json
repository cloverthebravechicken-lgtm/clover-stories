        "review_1": {
          "type": "review",
          "settings": {
            "rating": 5,
            "title": "Absolutely adorable",
            "text": "This book is absolutely adorable!!! My three year old loves it! The story is heartwarming and the illustrations are excellent!! Highly recommend for your kiddos!!",
            "author": "Kathryn",
            "verified": false
          }
        },
        "review_2": {
          "type": "review",
          "settings": {
            "rating": 5,
            "title": "Perfect read-aloud rhythm",
            "text": "As a mom to a 2 year old, we were SO excited to read this book. I really appreciate how it rhymes and has a great rhythm when I read it out loud. The illustrations are adorable and my son just loves pointing to each animal to tell me the sounds they make. It’s got a great message to it and I highly recommend it to anyone with littles (especially if they love farm animals)!",
            "author": "Kelsey",
            "verified": false
          }
        },
        "review_3": {
          "type": "review",
          "settings": {
            "rating": 5,
            "title": "We read it over and over",
            "text": "I purchased the book for my grandson and it is excellent! Very colorful, lots of farm animals that he loves and a good story! We read it over and over again!",
            "author": "Jane",
            "verified": false
          }
        },
        "review_4": {
          "type": "review",
          "settings": {
            "rating": 5,
            "title": "Perfect just the way they are",
            "text": "This book is perfect for little ones that are exploring their talents. It creates a sense that everyone is perfect just the way they are, and the way they were created to be!",
            "author": "Ashley",
            "verified": false
          }
        },
        "review_5": {
          "type": "review",
          "settings": {
            "rating": 5,
            "title": "Fantastic message",
            "text": "This book is great. The message and the illustrations are fantastic. My grandson loves the book. I hope there will be more books in the future!",
            "author": "Chandra",
            "verified": false
          }
        },
        "review_6": {
          "type": "review",
          "settings": {
            "rating": 5,
            "title": "You can be brave",
            "text": "Well written book for 2-5 years old. Teaches children being themselves is a good thing and no matter who you are, you can be brave.",
            "author": "Sandra",
            "verified": false
          }
        }
      },
