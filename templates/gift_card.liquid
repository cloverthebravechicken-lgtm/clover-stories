{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Your {{ gift_card.balance | money }} gift card — {{ shop.name }}</title>
    <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
    <style>
      body { font-family: system-ui, sans-serif; background: #EAFBFF; color: #2B1D14; margin: 0; padding: 40px 16px; text-align: center; }
      .gc { max-width: 440px; margin: 0 auto; background: #fff; border-radius: 24px; padding: 32px; box-shadow: 0 10px 30px rgba(0,0,0,.08); }
      .gc__code { font-size: 1.4rem; font-weight: 700; letter-spacing: .08em; background: #FFF3ED; border-radius: 12px; padding: 14px; margin: 16px 0; }
      .gc__btn { display: inline-block; background: #FF5757; color: #fff; text-decoration: none; font-weight: 700; padding: 14px 24px; border-radius: 999px; }
      #QrCode { display: flex; justify-content: center; margin: 16px 0; }
    </style>
  </head>
  <body>
    <div class="gc">
      <p>{{ shop.name }}</p>
      <h1>Here's your {{ gift_card.initial_value | money }} gift card!</h1>
      {%- if gift_card.expired or gift_card.enabled == false -%}
        <p>This gift card is no longer active.</p>
      {%- else -%}
        <p>Balance: <strong>{{ gift_card.balance | money }}</strong></p>
        <div class="gc__code">{{ gift_card.code | format_code }}</div>
        <div id="QrCode" data-identifier="{{ gift_card.qr_identifier }}"></div>
        <a class="gc__btn" href="{{ shop.url }}" target="_blank" rel="noopener">Start shopping</a>
      {%- endif -%}
    </div>
    <script>
      window.addEventListener('load', function () {
        var el = document.getElementById('QrCode');
        if (el && window.QRCode) new QRCode(el, { text: el.dataset.identifier, width: 120, height: 120 });
      });
    </script>
  </body>
</html>
