<cart-drawer class="drawer" id="CartDrawer" aria-hidden="true">
  <div class="drawer__overlay" data-cart-close></div>
  <div class="drawer__panel" role="dialog" aria-modal="true" aria-labelledby="CartDrawerTitle" tabindex="-1">
    <div class="drawer__head">
      <p class="drawer__title h4" id="CartDrawerTitle">Your basket {% render 'icon', name: 'egg', size: 18 %}</p>
      <button type="button" class="header__icon" aria-label="Close cart" data-cart-close>{% render 'icon', name: 'close', size: 24 %}</button>
    </div>

    <div class="drawer__content" data-cart-content>
      {%- if cart.item_count == 0 -%}
        <div class="drawer__empty">{% render 'empty-basket' %}</div>
      {%- else -%}
        {%- comment -%} Plush shipping isn't free, so swap the perk message when the plush or bundle is in the basket. {%- endcomment -%}
        {%- liquid
          assign perk = settings.cart_perk_text
          for item in cart.items
            if settings.cart_upsell_product != blank and item.product_id == settings.cart_upsell_product.id
              assign perk = settings.cart_perk_text_plush
            endif
            if settings.cart_bundle_product != blank and item.product_id == settings.cart_bundle_product.id
              assign perk = settings.cart_perk_text_plush
            endif
          endfor
        -%}
        {%- if perk != blank -%}
          <p class="drawer__perk">{{ perk }}</p>
        {%- endif -%}

        <ul class="cart-lines" role="list">
          {%- for item in cart.items -%}
            <li class="cart-line" data-line="{{ forloop.index }}">
              <a href="{{ item.url }}" class="cart-line__img">
                {%- if item.image -%}
                  {{ item.image | image_url: width: 360, height: 360, crop: 'center' | image_tag: loading: 'lazy', alt: item.product.title, width: 90, height: 90 }}
                {%- endif -%}
              </a>
              <div class="cart-line__info">
                <a href="{{ item.url }}" class="cart-line__title">{{ item.product.title }}</a>
                {%- unless item.product.has_only_default_variant -%}
                  <p class="cart-line__meta">{{ item.variant.title }}</p>
                {%- endunless -%}
                {%- for p in item.properties -%}
                  {%- assign first = p.first | slice: 0 -%}
                  {%- if p.last != blank and first != '_' -%}
                    <p class="cart-line__meta">{{ p.first }}: {{ p.last }}</p>
                  {%- endif -%}
                {%- endfor -%}
                <div class="cart-line__row">
                  <div class="qty qty--sm">
                    <button type="button" class="qty__btn" data-line-change="{{ item.quantity | minus: 1 }}" aria-label="Decrease quantity">{% render 'icon', name: 'minus', size: 14 %}</button>
                    <span class="qty__val">{{ item.quantity }}</span>
                    <button type="button" class="qty__btn" data-line-change="{{ item.quantity | plus: 1 }}" aria-label="Increase quantity">{% render 'icon', name: 'plus', size: 14 %}</button>
                  </div>
                  <span class="cart-line__price">
                    {%- if item.original_line_price > item.final_line_price -%}<s>{{ item.original_line_price | money }}</s> {% endif -%}
                    {{ item.final_line_price | money }}
                  </span>
                </div>
                <button type="button" class="cart-line__remove" data-line-change="0">Remove</button>
              </div>
            </li>
          {%- endfor -%}
        </ul>

        {% render 'inscription-upsell' %}

        {%- comment -%}
          Bundle upgrade: when the book is in the basket without the bundle, offer to swap it
          for the bundle for the price difference, pictured with the plush (the part they're adding).
          While it shows, the plush upsell is hidden.
        {%- endcomment -%}
        {%- liquid
          assign bundle = settings.cart_bundle_product
          assign bundle_book = settings.cart_bundle_book
          assign upsell = settings.cart_upsell_product
          assign book_item = nil
          assign has_bundle = false
          assign has_plush = false
          for item in cart.items
            if upsell != blank and item.product_id == upsell.id
              assign has_plush = true
            endif
            if bundle_book != blank and item.product_id == bundle_book.id and book_item == nil
              assign book_item = item
            endif
            if bundle != blank and item.product_id == bundle.id
              assign has_bundle = true
            endif
          endfor
          assign up_mode = ''
          if book_item and has_bundle == false and has_plush == false
            if bundle != blank and bundle.available
              assign up_mode = 'live'
              assign up_variant = bundle.selected_or_first_available_variant
              assign up_price = up_variant.price
              assign up_img = ''
              if upsell != blank and upsell.featured_image
                assign up_img = upsell.featured_image | image_url: width: 300, height: 300, crop: 'center'
              elsif bundle.featured_image
                assign up_img = bundle.featured_image | image_url: width: 300, height: 300, crop: 'center'
              endif
            elsif settings.launch_preview
              assign up_mode = 'preview'
              capture up_price
                render 'preview-field', key: 'bundle', field: 'cents'
              endcapture
              assign up_price = up_price | plus: 0
              capture up_img
                render 'preview-field', key: 'plush', field: 'image_url'
              endcapture
            endif
          endif
          if up_mode != ''
            assign up_diff = up_price | minus: book_item.final_price
            if up_diff <= 0
              assign up_mode = ''
            endif
          endif

          assign show_upsell = false
          if upsell != blank and upsell.available and up_mode == '' and has_bundle == false
            assign show_upsell = true
            for item in cart.items
              if item.product_id == upsell.id
                assign show_upsell = false
              endif
            endfor
          endif
        -%}
        {%- if up_mode != '' -%}
          {%- capture up_diff_text -%}<strong>{{ up_diff | money_without_trailing_zeros }}</strong>{%- endcapture -%}
          <div class="upsell upsell--bundle">
            <p class="upsell__heading">{{ settings.cart_bundle_heading }}</p>
            <div class="upsell__card">
              {%- if up_img != blank -%}
                <img src="{{ up_img }}" alt="" width="72" height="72" loading="lazy" class="upsell__img">
              {%- endif -%}
              <div class="upsell__info">
                <p class="upsell__title">{{ settings.cart_bundle_text | escape | replace: '[diff]', up_diff_text }}</p>
                <p class="upsell__price">Book + Clover plush for {{ up_price | money }}</p>
              </div>
              {%- if up_mode == 'live' -%}
                <button type="button" class="btn btn--primary btn--sm" data-bundle-upgrade data-key="{{ book_item.key }}" data-qty="{{ book_item.quantity }}" data-variant="{{ up_variant.id }}">{{ settings.cart_bundle_button }}</button>
              {%- else -%}
                <button type="button" class="btn btn--primary btn--sm" data-preview-add>{{ settings.cart_bundle_button }}</button>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
        {%- if show_upsell -%}
          {%- assign uv = upsell.selected_or_first_available_variant -%}
          <div class="upsell">
            <p class="upsell__heading">{{ settings.cart_upsell_heading }}</p>
            <div class="upsell__card">
              {%- if upsell.featured_image -%}
                {{ upsell.featured_image | image_url: width: 300, height: 300, crop: 'center' | image_tag: loading: 'lazy', alt: upsell.title, width: 72, height: 72, class: 'upsell__img' }}
              {%- endif -%}
              <div class="upsell__info">
                <p class="upsell__title">{{ upsell.title }}</p>
                <p class="upsell__price">{{ uv.price | money }}</p>
              </div>
              <button type="button" class="btn btn--primary btn--sm" data-quick-add="{{ uv.id }}">Add</button>
            </div>
          </div>
        {%- elsif settings.launch_preview and up_mode == '' and has_bundle == false -%}
          {%- liquid
            assign upsell_live = false
            if upsell != blank and upsell.available
              assign upsell_live = true
            endif
            capture pv_img
              render 'preview-field', key: 'plush', field: 'image_url'
            endcapture
          -%}
          {%- unless upsell_live -%}
            <div class="upsell">
              <p class="upsell__heading">{{ settings.cart_upsell_heading }}</p>
              <div class="upsell__card">
                {%- if pv_img != blank -%}
                  <img src="{{ pv_img }}" alt="" width="72" height="72" loading="lazy" class="upsell__img">
                {%- endif -%}
                <div class="upsell__info">
                  <p class="upsell__title">{% render 'preview-field', key: 'plush', field: 'title' %}</p>
                  <p class="upsell__price">{% render 'preview-field', key: 'plush', field: 'price' %}</p>
                </div>
                <button type="button" class="btn btn--primary btn--sm" data-preview-add>Add</button>
              </div>
            </div>
          {%- endunless -%}
        {%- endif -%}
      {%- endif -%}
    </div>

    {%- if cart.item_count > 0 -%}
      <div class="drawer__foot">
        {%- for discount in cart.cart_level_discount_applications -%}
          <p class="drawer__row drawer__row--discount"><span>{{ discount.title }}</span><span>-{{ discount.total_allocated_amount | money }}</span></p>
        {%- endfor -%}
        <p class="drawer__row drawer__subtotal"><span>Subtotal</span><strong>{{ cart.total_price | money_with_currency }}</strong></p>
        <p class="drawer__note">Taxes and discount codes are calculated at checkout.</p>
        <form action="{{ routes.cart_url }}" method="post">
          <button type="submit" name="checkout" class="btn btn--primary btn--xl btn--block">
            {% render 'icon', name: 'lock', size: 18 %} Checkout securely
          </button>
        </form>
        <p class="drawer__trust">
          <span>{% render 'icon', name: 'truck', size: 16 %} Free shipping on books</span>
          <span>{% render 'icon', name: 'shield', size: 16 %} Secure checkout</span>
        </p>
      </div>
    {%- endif -%}
  </div>
</cart-drawer>

{% schema %}
{
  "name": "Cart drawer",
  "settings": []
}
{% endschema %}
