<section class="section">
  <div class="container">
    <div class="section-head"><h1 class="h1">Collections</h1></div>
    <div class="pcards__grid">
      {%- for collection in collections -%}
        <a href="{{ collection.url }}" class="pcard card">
          <span class="pcard__media">
            {%- if collection.featured_image -%}
              {% render 'img', image: collection.featured_image, sizes: '(min-width: 990px) 30vw, 80vw' %}
            {%- endif -%}
          </span>
          <span class="pcard__body"><span class="pcard__title">{{ collection.title }}</span></span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collections list",
  "settings": []
}
{% endschema %}
