{%- comment -%}
  Only shows once at least two cards can be shown, so a "collection" of just the book stays
  hidden until the plush and bundle are live (or Launch preview is on).
{%- endcomment -%}
{%- liquid
  assign card_count = 0
  for block in section.blocks
    if block.settings.product != blank and block.settings.product.available
      assign card_count = card_count | plus: 1
    elsif settings.launch_preview and block.settings.preview_as != blank and block.settings.preview_as != 'none'
      assign card_count = card_count | plus: 1
    elsif block.settings.product != blank
      assign card_count = card_count | plus: 1
    endif
  endfor
-%}
{%- if card_count >= 2 -%}
<section class="pcards section anim" style="--bg: {{ section.settings.bg }};">
  <div class="container">
    <div class="section-head">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="h2">{{ section.settings.heading }}</h2>
    </div>
    <div class="pcards__grid">
      {%- for block in section.blocks -%}
        {%- if block.settings.product != blank and block.settings.product.available -%}
          <div {{ block.shopify_attributes }}>{% render 'product-card', product: block.settings.product, badge: block.settings.badge %}</div>
        {%- elsif settings.launch_preview and block.settings.preview_as != blank and block.settings.preview_as != 'none' -%}
          <div {{ block.shopify_attributes }}>{% render 'preview-card', key: block.settings.preview_as, badge: block.settings.badge %}</div>
        {%- elsif block.settings.product != blank -%}
          <div {{ block.shopify_attributes }}>{% render 'product-card', product: block.settings.product, badge: block.settings.badge %}</div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>
{%- elsif request.design_mode -%}
  <div class="container" style="padding: 18px 0; text-align: center; font-size: .9rem; opacity: .7;">
    Clover collection is hidden until at least two of its products are live (or Theme settings → Launch preview is on).
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Product cards",
  "settings": [
    { "type": "color", "id": "bg", "label": "Background", "default": "#FFFFFF" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Clover collection" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Storytime, snuggle time, gift time" }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "text", "id": "badge", "label": "Badge" },
        { "type": "select", "id": "preview_as", "label": "Launch preview: show as", "default": "none", "options": [{ "value": "none", "label": "Nothing" }, { "value": "plush", "label": "Clover Plush" }, { "value": "bundle", "label": "Book & Plush Bundle" }], "info": "Used while the product is still a draft and Theme settings → Launch preview is on." }
      ]
    }
  ],
  "presets": [{ "name": "Product cards", "blocks": [{ "type": "product" }, { "type": "product" }, { "type": "product" }] }]
}
{% endschema %}
