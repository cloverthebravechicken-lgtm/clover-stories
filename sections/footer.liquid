<footer class="footer" style="--bg: {{ section.settings.bg }}; --bg-deep: {{ section.settings.bg_deep }};">
  <div class="footer__meadow" aria-hidden="true">
    {%- if section.settings.mascot != blank -%}
      <span class="footer__walker footer__walker--faces-{{ section.settings.mascot_faces }}">
        <span class="footer__walker-flip">
          {{ section.settings.mascot | image_url: width: 240 | image_tag: loading: 'lazy', alt: '', width: 110, height: 110 }}
        </span>
      </span>
    {%- endif -%}
    {%- if section.settings.grazer != 'none' -%}
      <span class="footer__grazer">{% render 'critter', name: section.settings.grazer, side: 'right' %}</span>
    {%- endif -%}
    {% render 'grass' %}
  </div>

  <div class="footer__body">
    <div class="footer__inner container">
      <div class="footer__brand">
        <a href="{{ routes.root_url }}" class="footer__badge" aria-label="{{ shop.name }}">
          {%- if settings.logo != blank -%}
            {{ settings.logo | image_url: width: 400 | image_tag: loading: 'lazy', alt: shop.name, class: 'footer__logo', width: 170 }}
          {%- else -%}
            <span class="h3">{{ shop.name }}</span>
          {%- endif -%}
        </a>
        {%- if section.settings.text != blank -%}
          <div class="footer__text rte">{{ section.settings.text }}</div>
        {%- endif -%}
        <ul class="social footer__social" role="list">
          {%- if settings.social_instagram != blank -%}<li><a href="{{ settings.social_instagram }}" aria-label="Instagram" target="_blank" rel="noopener">{% render 'icon', name: 'instagram', size: 22 %}</a></li>{%- endif -%}
          {%- if settings.social_facebook != blank -%}<li><a href="{{ settings.social_facebook }}" aria-label="Facebook" target="_blank" rel="noopener">{% render 'icon', name: 'facebook', size: 22 %}</a></li>{%- endif -%}
          {%- if settings.social_tiktok != blank -%}<li><a href="{{ settings.social_tiktok }}" aria-label="TikTok" target="_blank" rel="noopener">{% render 'icon', name: 'tiktok', size: 22 %}</a></li>{%- endif -%}
          {%- if settings.social_pinterest != blank -%}<li><a href="{{ settings.social_pinterest }}" aria-label="Pinterest" target="_blank" rel="noopener">{% render 'icon', name: 'pinterest', size: 22 %}</a></li>{%- endif -%}
        </ul>
      </div>

      {%- if section.settings.menu != blank -%}
        <nav class="footer__nav" aria-label="{{ section.settings.menu_heading | escape }}">
          <p class="footer__heading">{{ section.settings.menu_heading }}</p>
          <ul role="list">
            {%- for link in section.settings.menu.links -%}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          </ul>
        </nav>
      {%- endif -%}

      {%- if section.settings.menu_2 != blank or section.settings.email != blank -%}
        <nav class="footer__nav" aria-label="{{ section.settings.menu_2_heading | escape }}">
          <p class="footer__heading">{{ section.settings.menu_2_heading }}</p>
          <ul role="list">
            {%- for link in section.settings.menu_2.links -%}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
            {%- if section.settings.email != blank -%}
              <li><a href="mailto:{{ section.settings.email }}" class="footer__email">{{ section.settings.email | escape | replace: '@', '<wbr>@' }}</a></li>
            {%- endif -%}
          </ul>
        </nav>
      {%- endif -%}

      <div class="footer__signup paper-notebook">
        <span class="footer__tape" aria-hidden="true"></span>
        <p class="footer__signup-title">{{ section.settings.signup_heading }}</p>
        {%- if section.settings.signup_text != blank -%}<div class="rte footer__signup-text">{{ section.settings.signup_text }}</div>{%- endif -%}
        {% render 'signup-form', form_id: 'FooterSignup', button: 'Join' %}
      </div>
    </div>

    <div class="footer__bottom">
      <div class="container footer__bottom-inner">
        <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | link_to: routes.root_url }}. Made with {% render 'icon', name: 'heart', size: 14 %} on the farm.</p>
        {%- if shop.policies.size > 0 -%}
          <ul class="footer__policies" role="list">
            {%- for policy in shop.policies -%}
              <li><a href="{{ policy.url }}">{{ policy.title }}</a></li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
        {%- if section.settings.show_payment_icons -%}
          <ul class="payment-icons" role="list">
            {%- for type in shop.enabled_payment_types -%}
              <li>{{ type | payment_type_svg_tag: class: 'payment-icon' }}</li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "section-footer",
  "settings": [
    { "type": "color", "id": "bg", "label": "Background", "default": "#5FA044" },
    { "type": "color", "id": "bg_deep", "label": "Bottom strip background", "default": "#3F7A2C" },
    { "type": "image_picker", "id": "mascot", "label": "Clover strolling on the grass" },
    { "type": "select", "id": "mascot_faces", "label": "Clover faces this way in the image", "options": [{ "value": "left", "label": "Left" }, { "value": "right", "label": "Right" }], "default": "left" },
    { "type": "select", "id": "grazer", "label": "Farm friend grazing on the grass", "options": [{ "value": "none", "label": "None" }, { "value": "horse", "label": "Horse" }, { "value": "cow", "label": "Cow" }, { "value": "duck", "label": "Duck" }, { "value": "goat", "label": "Goat" }, { "value": "chicks", "label": "Chicks" }], "default": "cow" },
    { "type": "richtext", "id": "text", "label": "About text", "default": "<p>Heartwarming picture books that help little ones discover the bravest thing they can be is themselves.</p>" },
    { "type": "text", "id": "menu_heading", "label": "First menu heading", "default": "Explore" },
    { "type": "link_list", "id": "menu", "label": "First menu", "default": "main-menu" },
    { "type": "text", "id": "menu_2_heading", "label": "Second menu heading", "default": "Help" },
    { "type": "link_list", "id": "menu_2", "label": "Second menu", "default": "footer" },
    { "type": "text", "id": "email", "label": "Email shown under the second menu", "default": "hello@cloverstories.com" },
    { "type": "text", "id": "signup_heading", "label": "Signup heading", "default": "Join Clover's Club" },
    { "type": "richtext", "id": "signup_text", "label": "Signup text", "default": "<p>Get instant access to a free 10-page activity packet!</p>" },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Show payment icons", "default": true }
  ]
}
{% endschema %}
