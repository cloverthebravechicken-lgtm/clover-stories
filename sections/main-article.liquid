<article class="section">
  <div class="container container--narrow">
    <p class="eyebrow center">{{ article.published_at | date: '%B %d, %Y' }}</p>
    <h1 class="h1 center">{{ article.title }}</h1>
    {%- if article.image -%}
      <div class="article__img mt-m">{% render 'img', image: article.image, sizes: '(min-width: 990px) 800px, 100vw', eager: true %}</div>
    {%- endif -%}
    <div class="rte mt-m">{{ article.content }}</div>
    <p class="mt-l"><a href="{{ blog.url }}" class="btn">← Back to {{ blog.title }}</a></p>
  </div>
</article>

{% schema %}
{
  "name": "Article",
  "settings": []
}
{% endschema %}
