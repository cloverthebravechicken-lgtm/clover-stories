{%- assign pages = section.blocks | where: 'type', 'page' -%}
<section class="line section anim" style="--bg: {{ section.settings.bg }};">
  <div class="container">
    <div class="section-head">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<div class="rte section-head__text">{{ section.settings.text }}</div>{%- endif -%}
    </div>
  </div>

  {%- comment -%}
    Two arrangements of the same pages: wide lines for desktop, and shorter lines on phones and
    tablets so every page fits on screen without sideways scrolling.
  {%- endcomment -%}
  {%- for variant in (1..2) -%}
  {%- liquid
    if variant == 1
      assign per_row = section.settings.per_row
      assign layout = 'desktop'
    else
      assign per_row = section.settings.per_row_mobile
      assign layout = 'mobile'
    endif
    assign row_count = pages.size | plus: per_row | minus: 1 | divided_by: per_row | floor
    assign last_row = row_count | minus: 1
  -%}
  <div class="line__rows line__rows--{{ layout }}">
    {%- for r in (0..last_row) -%}
      {%- assign offset = r | times: per_row -%}
      <div class="line__rail" tabindex="-1" aria-label="Pages in the activity packet, row {{ r | plus: 1 }}">
        <div class="line__row" style="--cols: {{ per_row }};">
          <svg class="line__rope" viewBox="0 0 1000 80" preserveAspectRatio="none" aria-hidden="true" focusable="false">
            <path d="M0 8 Q500 {{ section.settings.sag | times: 2 | plus: 8 }} 1000 8"/>
          </svg>
          <ul class="line__list" role="list">
          {%- for block in pages limit: per_row offset: offset -%}
            {%- liquid
              assign n = forloop.length
              assign i = forloop.index0
              assign a = i | times: 2 | plus: 1
              assign b = n | times: 2 | minus: a
              assign nn = n | times: n
              assign drop = a | times: b | times: section.settings.sag | divided_by: nn
              assign num = offset | plus: forloop.index
            -%}
            {%- if block.settings.image != blank -%}
              <li class="line__item" style="--drop: {{ drop }}px; --d: -{{ num | times: 0.7 | modulo: 4 }}s;"{% if variant == 1 %} {{ block.shopify_attributes }}{% endif %}>
                <div class="line__swing">
                  <span class="line__pin" aria-hidden="true"></span>
                  <button type="button" class="line__page" data-lightbox="{{ block.settings.image | image_url: width: 1600 }}" data-lightbox-alt="{{ block.settings.label | escape }}" aria-label="View {{ block.settings.label | escape }} page">
                    {{ block.settings.image | image_url: width: 500 | image_tag: loading: 'lazy', alt: block.settings.label, widths: '240, 360, 500', sizes: '(min-width: 990px) 200px, 45vw' }}
                    <span class="line__num">{{ num }}</span>
                  </button>
                  <span class="line__label">
                    {%- if block.settings.emoji != blank -%}<span aria-hidden="true">{{ block.settings.emoji }}</span> {% endif -%}
                    {{ block.settings.label }}
                  </span>
                </div>
              </li>
            {%- endif -%}
          {%- endfor -%}
          </ul>
        </div>
      </div>
    {%- endfor -%}
  </div>
  {%- endfor -%}
  <p class="line__hint center">Tap any page to take a closer look</p>

  {%- if section.settings.button_label != blank -%}
    <div class="container center mt-m">
      <a href="{{ section.settings.button_link | default: '#get-packet' }}" class="btn btn--primary btn--lg btn--wiggle">{{ section.settings.button_label }}</a>
    </div>
  {%- endif -%}

  <dialog class="lightbox" data-lightbox-dialog>
    <button type="button" class="lightbox__close round-btn" aria-label="Close" data-lightbox-close>{% render 'icon', name: 'close', size: 22 %}</button>
    <img alt="" width="1545" height="2000" data-lightbox-img>
  </dialog>
</section>

{% schema %}
{
  "name": "Clothesline gallery",
  "settings": [
    { "type": "color", "id": "bg", "label": "Background", "default": "#FFFFFF" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "What's inside" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "10 pages of farmyard fun" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "range", "id": "per_row", "label": "Pages per line", "min": 3, "max": 6, "step": 1, "default": 5 },
    { "type": "range", "id": "per_row_mobile", "label": "Pages per line on phones and tablets", "min": 1, "max": 3, "step": 1, "default": 2 },
    { "type": "range", "id": "sag", "label": "How much the line sags", "min": 0, "max": 60, "step": 2, "unit": "px", "default": 28 },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Get all 10 pages free" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "page",
      "name": "Page",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Page image" },
        { "type": "text", "id": "label", "label": "Label", "default": "Coloring" },
        { "type": "text", "id": "emoji", "label": "Emoji" }
      ]
    }
  ],
  "presets": [{ "name": "Clothesline gallery", "blocks": [{ "type": "page" }, { "type": "page" }, { "type": "page" }] }]
}
{% endschema %}
