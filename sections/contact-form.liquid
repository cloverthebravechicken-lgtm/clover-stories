<section class="section contact" style="--bg: {{ section.settings.bg }};">
  <div class="container container--narrow">
    <div class="section-head">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h1 class="h1">{{ section.settings.heading | default: page.title }}</h1>
      {%- if page.content != blank -%}<div class="rte section-head__text">{{ page.content }}</div>{%- endif -%}
    </div>
    <div class="card">
      {%- form 'contact', class: 'stack' -%}
        {%- if form.posted_successfully? -%}
          <p class="signup__ok" role="status">{% render 'icon', name: 'check', size: 18 %} Thanks! Melanie will get back to you soon.</p>
        {%- endif -%}
        {{ form.errors | default_errors }}
        <label for="ContactName">Name</label>
        <input id="ContactName" class="input" type="text" name="contact[name]" autocomplete="name" value="{{ form.name }}">
        <label for="ContactEmail">Email</label>
        <input id="ContactEmail" class="input" type="email" name="contact[email]" autocomplete="email" required value="{{ form.email }}">
        <label for="ContactBody">Message</label>
        <textarea id="ContactBody" class="input" name="contact[body]" rows="5" placeholder="{{ section.settings.placeholder | escape }}">{{ form.body }}</textarea>
        <button type="submit" class="btn btn--primary btn--lg">Send message</button>
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact form",
  "settings": [
    { "type": "color", "id": "bg", "label": "Background", "default": "#EAFBFF" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Say hello" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get in touch" },
    { "type": "text", "id": "placeholder", "label": "Message placeholder", "default": "School visits, bulk orders, or just to say hi…" }
  ],
  "presets": [{ "name": "Contact form" }]
}
{% endschema %}
