<section class="section">
  <div class="container">
    <div class="section-head"><h1 class="h1">{{ blog.title }}</h1></div>
    {%- paginate blog.articles by 12 -%}
      <div class="pcards__grid">
        {%- for article in blog.articles -%}
          <a href="{{ article.url }}" class="pcard card">
            {%- if article.image -%}<span class="pcard__media">{% render 'img', image: article.image, sizes: '(min-width: 990px) 30vw, 90vw' %}</span>{%- endif -%}
            <span class="pcard__body">
              <span class="pcard__title">{{ article.title }}</span>
              <span class="fine">{{ article.published_at | date: '%B %d, %Y' }}</span>
            </span>
          </a>
        {%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}<nav class="pagination" aria-label="Pagination">{{ paginate | default_pagination }}</nav>{%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Blog",
  "settings": []
}
{% endschema %}
