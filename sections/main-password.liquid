<section class="section center password" style="--bg: #EAFBFF;">
  <div class="container container--narrow">
    {%- if settings.logo != blank -%}
      {{ settings.logo | image_url: width: 520 | image_tag: alt: shop.name, class: 'password__logo' }}
    {%- else -%}
      <p class="h2">{{ shop.name }}</p>
    {%- endif -%}
    <h1 class="h1 mt-m">{{ section.settings.heading }}</h1>
    {%- if shop.password_message != blank -%}<p class="mt-m">{{ shop.password_message }}</p>{%- endif -%}
    <div class="card mt-m">
      {% render 'signup-form', form_id: 'PasswordSignup', button: 'Notify me' %}
    </div>
    <details class="mt-l">
      <summary class="fine">Store owner? Enter password</summary>
      {%- form 'storefront_password', class: 'signup__row mt-m' -%}
        {{ form.errors | default_errors }}
        <label class="visually-hidden" for="StorePassword">Password</label>
        <input id="StorePassword" class="input" type="password" name="password" autocomplete="current-password" placeholder="Password">
        <button type="submit" class="btn btn--primary">Enter</button>
      {%- endform -%}
    </details>
  </div>
</section>

{% schema %}
{
  "name": "Password page",
  "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "Something brave is hatching…" }]
}
{% endschema %}
