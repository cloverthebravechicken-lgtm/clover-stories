<section class="reviews section anim" id="reviews" style="--bg: {{ section.settings.bg }};">
  {% render 'deco', name: 'scallop', color: section.settings.bg, flip: true %}
  <div class="container">
    <div class="section-head">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="h2">{{ section.settings.heading }}</h2>
      <p class="reviews__summary">{% render 'stars', rating: 5, size: 22 %} <span>{{ section.settings.summary }}</span></p>
    </div>
  </div>
  <div class="reviews__rail" data-rail tabindex="0" aria-label="Customer reviews">
    {%- for block in section.blocks -%}
      <figure class="review card tilt-{{ forloop.index | modulo: 3 }}" {{ block.shopify_attributes }}>
        {% render 'stars', rating: block.settings.rating, size: 16 %}
        {%- if block.settings.title != blank -%}<p class="review__title">{{ block.settings.title }}</p>{%- endif -%}
        <blockquote class="review__text">“{{ block.settings.text }}”</blockquote>
        <figcaption class="review__author">
          <span class="review__avatar" aria-hidden="true">{{ block.settings.author | slice: 0 }}</span>
          <span>
            <strong>{{ block.settings.author }}</strong>
            {%- if block.settings.verified -%}<small class="review__verified">{% render 'icon', name: 'check', size: 12 %} Verified buyer</small>{%- endif -%}
          </span>
        </figcaption>
      </figure>
    {%- endfor -%}
  </div>
  <div class="container peek__nav">
    <button type="button" class="round-btn" data-rail-prev aria-label="Previous review">{% render 'icon', name: 'arrow', size: 20 %}</button>
    <button type="button" class="round-btn" data-rail-next aria-label="Next review">{% render 'icon', name: 'arrow', size: 20 %}</button>
  </div>
  {%- if section.settings.button_label != blank -%}
    <p class="center mt-l"><a href="{{ section.settings.button_link | default: '#top-buy' }}" class="btn btn--primary btn--lg">{{ section.settings.button_label }}</a></p>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Review wall",
  "settings": [
    { "type": "color", "id": "bg", "label": "Background", "default": "#FFF3ED" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Real families, real smiles" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "What people are saying" },
    { "type": "text", "id": "summary", "label": "Summary text", "default": "5-star reviews from parents, grandparents & teachers" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Join the Clover fan club" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "range", "id": "rating", "label": "Rating", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "text", "label": "Review", "default": "My little one asks for Clover every single night!" },
        { "type": "text", "id": "author", "label": "Author", "default": "Happy parent" },
        { "type": "checkbox", "id": "verified", "label": "Verified buyer", "default": false }
      ]
    }
  ],
  "presets": [{ "name": "Review wall", "blocks": [{ "type": "review" }, { "type": "review" }, { "type": "review" }] }]
}
{% endschema %}
