{%- liquid
  assign source = section.settings.source_product | default: product
  assign jm_reviews = blank
  if section.settings.use_judgeme and source != blank
    assign jm = source.metafields.judgeme.review_widget_json_ld.value
    if jm.review.size > 0
      assign jm_reviews = jm.review
    endif
  endif
  assign min_len = section.settings.min_length
  # Which Judge.me reviews are from verified buyers: read Judge.me's own review list and keep a
  # whitespace-free snippet of each verified review's text to match against below
  assign verified_keys = '|'
  assign imported_keys = '|'
  if jm_reviews != blank
    assign ssr = source.metafields.judgeme.review_widget_ssr_html.value
    assign chunks = ssr | split: "<div class='jdgm-rev "
    for c in chunks
      assign vb = c | split: "jdgm-rev__body'>" | last | split: '</div>' | first | strip_html | strip_newlines | remove: ' ' | remove: '&nbsp;' | downcase | slice: 0, 24
      if c contains "data-verified-buyer='true'"
        assign verified_keys = verified_keys | append: vb | append: '|'
      elsif c contains 'review_collected_from_another_provider'
        # imported reviews (verified Amazon purchases)
        assign imported_keys = imported_keys | append: vb | append: '|'
      endif
    endfor
  endif
-%}
<section class="reviews section anim" id="reviews" style="--bg: {{ section.settings.bg }};">
  {% render 'deco', name: 'scallop', color: section.settings.bg, flip: true %}
  <div class="container">
    <div class="section-head">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="h2">{{ section.settings.heading }}</h2>
      <p class="reviews__summary">
        {% render 'stars', rating: 5, size: 22 %}
        <span>
          {{ section.settings.summary }}
        </span>
      </p>
    </div>
  </div>
  <div class="reviews__rail" data-rail{% if section.settings.autoscroll %} data-autoscroll="{{ section.settings.autoscroll_speed }}"{% endif %} tabindex="0" aria-label="Customer reviews">
    {%- if jm_reviews != blank -%}
      {%- assign shown = 0 -%}
      {%- for r in jm_reviews -%}
        {%- assign body = r.reviewBody | strip -%}
        {%- if r.reviewRating.ratingValue >= 5 and body.size >= min_len and shown < section.settings.max_reviews -%}
          {%- assign shown = shown | plus: 1 -%}
          {%- assign author = r.author.name | default: 'Happy reader' -%}
          {%- if author == 'Anonymous' -%}{%- assign author = 'Happy reader' -%}{%- endif -%}
          {%- assign rkey = body | strip_newlines | remove: ' ' | downcase | slice: 0, 24 | prepend: '|' | append: '|' -%}
          <figure class="review card tilt-{{ shown | modulo: 3 }}">
            {% render 'stars', rating: 5, size: 16 %}
            <blockquote class="review__text">“{{ body | escape }}”</blockquote>
            <figcaption class="review__author">
              <span class="review__avatar" aria-hidden="true">{{ author | slice: 0 | upcase }}</span>
              <span>
                <strong>{{ author | capitalize }}</strong>
                {%- if verified_keys contains rkey -%}<small class="review__verified">{% render 'icon', name: 'check', size: 12 %} Verified buyer</small>
                {%- elsif section.settings.imported_label != blank and imported_keys contains rkey -%}<small class="review__verified">{% render 'icon', name: 'check', size: 12 %} {{ section.settings.imported_label }}</small>{%- endif -%}
              </span>
            </figcaption>
          </figure>
        {%- endif -%}
      {%- endfor -%}
    {%- else -%}
      {%- for block in section.blocks -%}
        <figure class="review card tilt-{{ forloop.index | modulo: 3 }}" {{ block.shopify_attributes }}>
          {% render 'stars', rating: block.settings.rating, size: 16 %}
          {%- if block.settings.title != blank -%}<p class="review__title">{{ block.settings.title }}</p>{%- endif -%}
          <blockquote class="review__text">“{{ block.settings.text }}”</blockquote>
          <figcaption class="review__author">
            <span class="review__avatar" aria-hidden="true">{{ block.settings.author | slice: 0 }}</span>
            <span>
              <strong>{{ block.settings.author }}</strong>
              {%- if block.settings.verified -%}<small class="review__verified">{% render 'icon', name: 'check', size: 12 %} Verified buyer</small>{%- endif -%}
            </span>
          </figcaption>
        </figure>
      {%- endfor -%}
    {%- endif -%}
  </div>
  <div class="container peek__nav">
    <button type="button" class="round-btn" data-rail-prev aria-label="Previous review">{% render 'icon', name: 'arrow', size: 20 %}</button>
    <button type="button" class="round-btn" data-rail-next aria-label="Next review">{% render 'icon', name: 'arrow', size: 20 %}</button>
  </div>
  {%- if section.settings.button_label != blank -%}
    <div class="container"><p class="center mt-l"><a href="{{ section.settings.button_link | default: '#top-buy' }}" class="btn btn--primary btn--lg">{{ section.settings.button_label }}</a></p></div>
  {%- endif -%}
  {% render 'critter', name: section.settings.critter, side: section.settings.critter_side %}
</section>

{% schema %}
{
  "name": "Review wall",
  "settings": [
    { "type": "checkbox", "id": "autoscroll", "label": "Slowly scroll reviews (pauses on hover)", "default": true },
    { "type": "range", "id": "autoscroll_speed", "label": "Scroll speed", "min": 10, "max": 80, "step": 5, "unit": "px", "default": 30, "info": "Pixels per second" },
    { "type": "select", "id": "critter", "label": "Farm friend peeking in", "options": [{ "value": "none", "label": "None" }, { "value": "horse", "label": "Horse" }, { "value": "cow", "label": "Cow" }, { "value": "duck", "label": "Duck" }, { "value": "goat", "label": "Goat" }, { "value": "chicks", "label": "Chicks" }], "default": "none" },
    { "type": "select", "id": "critter_side", "label": "Farm friend side", "options": [{ "value": "left", "label": "Left" }, { "value": "right", "label": "Right" }], "default": "right" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#FFF3ED" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Real families, real smiles" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "What people are saying" },
    { "type": "checkbox", "id": "use_judgeme", "label": "Pull 5-star reviews from Judge.me automatically", "default": true, "info": "Falls back to the review blocks below if there are no Judge.me reviews." },
    { "type": "product", "id": "source_product", "label": "Product to pull Judge.me reviews from", "info": "Defaults to the current product on product pages." },
    { "type": "text", "id": "imported_label", "label": "Tag for reviews imported into Judge.me", "default": "Verified Amazon buyer", "info": "Shown on reviews you imported from another site (e.g. Amazon). Leave blank to show no tag." },
    { "type": "range", "id": "min_length", "label": "Hide reviews shorter than", "min": 0, "max": 120, "step": 5, "unit": "chr", "default": 40 },
    { "type": "range", "id": "max_reviews", "label": "Maximum reviews", "min": 3, "max": 100, "step": 1, "default": 100, "info": "Set high so new reviews are added without older ones dropping off." },
    { "type": "text", "id": "summary", "label": "Summary text", "default": "5-star reviews from parents, grandparents & teachers" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Join the Clover fan club" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "range", "id": "rating", "label": "Rating", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "text", "label": "Review", "default": "My little one asks for Clover every single night!" },
        { "type": "text", "id": "author", "label": "Author", "default": "Happy parent" },
        { "type": "checkbox", "id": "verified", "label": "Verified buyer", "default": false }
      ]
    }
  ],
  "presets": [{ "name": "Review wall", "blocks": [{ "type": "review" }, { "type": "review" }, { "type": "review" }] }]
}
{% endschema %}
