{%- comment -%} Decorative animated crayons, a pencil and hand-drawn doodles for the activity signup card. {%- endcomment -%}
{%- if part == 'outside' -%}
<div class="crayons" aria-hidden="true">
  {%- assign colors = '#FF5757,#FFB800,#518339,#6C8CFF,#FE924E' | split: ',' -%}
  {%- for c in colors -%}
    <span class="crayon crayon--{{ forloop.index }}">
      <svg viewBox="0 0 24 120" focusable="false">
        <path d="M6 22 L12 2 L18 22 Z" fill="{{ c }}"/>
        <path d="M10 8 L12 2 L14 8 Z" fill="rgba(0,0,0,.25)"/>
        <rect x="4" y="22" width="16" height="96" rx="3" fill="{{ c }}"/>
        <rect x="4" y="34" width="16" height="52" fill="rgba(255,255,255,.28)"/>
        <rect x="4" y="38" width="16" height="3" fill="rgba(0,0,0,.18)"/>
        <rect x="4" y="79" width="16" height="3" fill="rgba(0,0,0,.18)"/>
        <rect x="6" y="24" width="3" height="92" rx="1.5" fill="rgba(255,255,255,.35)"/>
      </svg>
    </span>
  {%- endfor -%}
  <span class="pencil">
    <svg viewBox="0 0 20 140" focusable="false">
      <path d="M4 28 L10 4 L16 28 Z" fill="#F3D2A2"/>
      <path d="M8 12 L10 4 L12 12 Z" fill="#3a3a3a"/>
      <rect x="4" y="28" width="12" height="92" fill="#FFB800"/>
      <rect x="8" y="28" width="4" height="92" fill="rgba(255,255,255,.3)"/>
      <rect x="4" y="120" width="12" height="8" fill="#b8b8b8"/>
      <rect x="4" y="128" width="12" height="10" rx="3" fill="#FF8FA3"/>
    </svg>
  </span>
</div>
{%- else -%}
<div class="doodles" aria-hidden="true">
  <svg class="doodle doodle--star" viewBox="0 0 40 40" focusable="false"><path d="M20 3 L24.5 15 L37 15.5 L27 23.5 L30.5 36 L20 28.5 L9.5 36 L13 23.5 L3 15.5 L15.5 15 Z"/></svg>
  <svg class="doodle doodle--squiggle" viewBox="0 0 80 24" focusable="false"><path d="M3 14 C10 2, 16 2, 20 12 S30 22, 36 12 S46 2, 52 12 S62 22, 68 12 S76 6, 78 10"/></svg>
  <svg class="doodle doodle--heart" viewBox="0 0 32 30" focusable="false"><path d="M16 27 C4 18, 2 10, 6 5.5 C10 1.5, 15 4, 16 8 C17 4, 22 1.5, 26 5.5 C30 10, 28 18, 16 27 Z"/></svg>
  <svg class="doodle doodle--swirl" viewBox="0 0 48 48" focusable="false"><path d="M24 24 C24 20, 30 20, 30 25 C30 31, 20 32, 18 25 C16 16, 30 12, 35 20 C40 30, 30 40, 20 38 C8 36, 6 20, 14 12"/></svg>
</div>
{%- endif -%}
