{%- comment -%}
  Usage: {% render 'stars', rating: 5, size: 18, label: 'Rated 5 out of 5' %}
{%- endcomment -%}
{%- assign r = rating | default: 5 | round -%}
{%- assign icon_size = size | default: 18 -%}
<span class="stars" role="img" aria-label="{{ label | default: 'Rated 5 out of 5 stars' | escape }}">
  {%- for i in (1..5) -%}
    <span class="stars__s{% if i > r %} is-empty{% endif %}">{% render 'icon', name: 'star', size: icon_size %}</span>
  {%- endfor -%}
</span>
