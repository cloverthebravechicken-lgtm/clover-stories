{%- comment -%}
  Conversion-focused buy box used by the homepage hero and the product page.

  Params:
  - product: the primary product (book)
  - section: parent section (reads offer blocks + add-on settings)
  - form_id: unique id
  - require_match: only show offers when `product` is one of them (product page)

  Section settings used:
  - addon_product, addon_label, addon_placeholder
  - button_label, show_buy_now, show_payment_buttons
  - preselect_first: select the first available offer instead of the main product's offer
    (with Launch preview on, a still-draft first offer's preview card is selected)
  Offer blocks (type "offer"): product, title, subtitle, badge, layout (card/compact), preview_as
  Optional per-offer "note" replaces the section's price note while that offer is selected
  (e.g. plush shipping on the bundle).
  Cards show "Save $X" when the variant has a compare-at price (the bundle).
  While the product is sold out and Theme settings > Back in stock is on, the add-to-cart
  controls are replaced by a slim "notify me" email row (snippets/notify-me.liquid). Sold-out
  options show as slim greyed rows; when Back in stock > "Offer instead" has a product in stock,
  it's added below them, ready to buy.
  With Theme settings → Launch preview on, an offer whose product isn't live yet (draft) still
  shows, using the preview title/price/image, but can't be added to the cart.
{%- endcomment -%}
{%- liquid
  assign offers_count = 0
  assign offer_match = false
  assign checked_id = blank
  assign preview_first = false
  assign has_live_offer = false
  for block in section.blocks
    if block.type == 'offer' and settings.notify_enabled and block.settings.product != blank and block.settings.product.available == false
      unless settings.launch_preview and block.settings.preview_as != blank and block.settings.preview_as != 'none'
        assign offers_count = offers_count | plus: 1
        if block.settings.product.id == product.id
          assign offer_match = true
        endif
      endunless
    endif
    if block.type == 'offer' and block.settings.product != blank and block.settings.product.available
      assign offers_count = offers_count | plus: 1
      assign has_live_offer = true
      if checked_id == blank
        assign checked_id = block.settings.product.id
      endif
      if block.settings.product.id == product.id
        assign offer_match = true
        unless section.settings.preselect_first
          assign checked_id = product.id
        endunless
      endif
    elsif block.type == 'offer' and settings.launch_preview and block.settings.preview_as != blank and block.settings.preview_as != 'none'
      unless block.settings.product != blank and block.settings.product.available
        assign offers_count = offers_count | plus: 1
        if checked_id == blank and section.settings.preselect_first
          assign preview_first = true
          assign checked_id = 'preview'
        endif
      endunless
    endif
  endfor
  if require_match and offer_match == false
    assign offers_count = 0
  endif
  # While everything here is sold out, offer a stand-in that's still in stock
  # (Theme settings > Back in stock > "Offer instead", e.g. the plush on the homepage).
  assign fallback = blank
  if settings.notify_enabled and has_live_offer == false and product.available == false
    assign fb = settings.notify_fallback_product
    if fb != blank and fb.available and fb.id != product.id
      assign fallback = fb
      assign has_live_offer = true
      assign offers_count = offers_count | plus: 1
    endif
  endif
  assign current_variant = product.selected_or_first_available_variant
  assign addon = section.settings.addon_product
  # Sold out: the add-to-cart controls give way to a "notify me" form. If another option can still
  # be bought (e.g. the plush when the book and bundle are out), it stays buyable and the form
  # sits underneath.
  assign show_notify = false
  assign can_buy = current_variant.available
  if offers_count > 1 and has_live_offer
    assign can_buy = true
  endif
  if fallback != blank
    assign can_buy = true
  endif
  if settings.notify_enabled and current_variant.available == false
    assign show_notify = true
  endif
-%}

<buy-form class="buy-form" data-section="{{ section.id }}">
  {%- form 'product', product, id: form_id, class: 'buy-form__form', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
    <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-input>

    {%- if offers_count > 1 or fallback != blank -%}
      <fieldset class="offers">
        <legend class="offers__legend">Choose your Clover</legend>
        {%- for block in section.blocks -%}
          {%- if block.type == 'offer' -%}
            {%- liquid
              assign op = block.settings.product
              assign o_live = false
              assign o_preview = false
              assign o_soldout = false
              if op != blank and op.available
                assign o_live = true
              elsif settings.launch_preview and block.settings.preview_as != blank and block.settings.preview_as != 'none'
                assign o_preview = true
              elsif settings.notify_enabled and op != blank
                # Sold-out options shrink to a slim greyed row
                assign o_live = true
                assign o_soldout = true
              endif
            -%}
            {%- if o_live or o_preview -%}
              {%- liquid
                assign o_compact = false
                if block.settings.layout == 'compact' or o_soldout
                  assign o_compact = true
                endif
                assign o_checked = false
                assign o_img = blank
                if o_live
                  assign ov = op.selected_or_first_available_variant
                  assign o_value = ov.id
                  assign o_price = ov.price
                  assign o_compare = ov.compare_at_price | default: 0
                  assign o_title = block.settings.title | default: op.title
                  if op.featured_image
                    assign o_img = op.featured_image | image_url: width: 160
                  endif
                  if op.id == checked_id
                    assign o_checked = true
                  endif
                else
                  assign pk = block.settings.preview_as
                  assign o_value = ''
                  if preview_first
                    assign o_checked = true
                    assign preview_first = false
                  endif
                  capture o_price
                    render 'preview-field', key: pk, field: 'cents'
                  endcapture
                  capture o_compare
                    render 'preview-field', key: pk, field: 'compare_cents'
                  endcapture
                  assign o_price = o_price | plus: 0
                  assign o_compare = o_compare | plus: 0
                  capture o_title
                    if block.settings.title != blank
                      echo block.settings.title
                    else
                      render 'preview-field', key: pk, field: 'title'
                    endif
                  endcapture
                  capture o_img
                    render 'preview-field', key: pk, field: 'image_url'
                  endcapture
                endif
                assign o_save = 0
                if o_compare > o_price
                  assign o_save = o_compare | minus: o_price
                endif
              -%}
              <label class="offer{% if o_compact %} offer--compact{% endif %}{% if o_preview %} offer--preview{% endif %}{% if o_soldout %} offer--soldout{% endif %}{% if block.settings.badge != blank and o_compact == false %} offer--badged{% endif %}" {{ block.shopify_attributes }}>
                <input
                  type="radio"
                  name="offer-{{ form_id }}"
                  value="{{ o_value }}"
                  data-price="{{ o_price | money }}"
                  {% if block.settings.note != blank %}data-note="{{ block.settings.note | escape }}"{% endif %}
                  {% if o_preview %}data-preview="{{ pk }}"{% endif %}
                  {% if block.settings.hide_addon %}data-no-addon{% endif %}
                  {% if o_checked and o_soldout == false %}checked{% endif %}
                  {% if o_soldout %}disabled{% endif %}
                >
                {%- if block.settings.badge != blank and o_compact == false -%}
                  <span class="offer__badge">{{ block.settings.badge }}</span>
                {%- endif -%}
                <span class="offer__radio" aria-hidden="true"></span>
                {%- if o_img != blank and o_compact == false -%}
                  <span class="offer__img"><img src="{{ o_img }}" alt="" width="80" height="80" loading="lazy"></span>
                {%- endif -%}
                <span class="offer__body">
                  <span class="offer__title">{{ o_title }}</span>
                  {%- if block.settings.subtitle != blank and o_soldout == false -%}
                    <span class="offer__sub">{{ block.settings.subtitle }}</span>
                  {%- endif -%}
                </span>
                <span class="offer__price">
                  {%- if o_soldout -%}<span class="offer__soldout">Sold out</span>{%- endif -%}
                  <strong>{{ o_price | money }}</strong>
                  {%- if o_save > 0 and o_compact == false and o_soldout == false -%}
                    <s>{{ o_compare | money }}</s>
                    <span class="offer__save">Save {{ o_save | money }}</span>
                  {%- endif -%}
                </span>
              </label>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
        {%- if fallback != blank -%}
          {%- assign fv = fallback.selected_or_first_available_variant -%}
          <label class="offer offer--fallback">
            <input
              type="radio"
              name="offer-{{ form_id }}"
              value="{{ fv.id }}"
              data-price="{{ fv.price | money }}"
              {% if settings.notify_fallback_note != blank %}data-note="{{ settings.notify_fallback_note | escape }}"{% endif %}
              data-no-addon
              checked
            >
            {%- if settings.notify_fallback_badge != blank -%}<span class="offer__badge">{{ settings.notify_fallback_badge }}</span>{%- endif -%}
            <span class="offer__radio" aria-hidden="true"></span>
            {%- if fallback.featured_image -%}
              <span class="offer__img"><img src="{{ fallback.featured_image | image_url: width: 160 }}" alt="" width="80" height="80" loading="lazy"></span>
            {%- endif -%}
            <span class="offer__body">
              <span class="offer__title">{{ settings.notify_fallback_title | default: fallback.title }}</span>
              {%- if settings.notify_fallback_subtitle != blank -%}<span class="offer__sub">{{ settings.notify_fallback_subtitle }}</span>{%- endif -%}
            </span>
            <span class="offer__price"><strong>{{ fv.price | money }}</strong></span>
          </label>
        {%- endif -%}
      </fieldset>
    {%- elsif product.has_only_default_variant == false -%}
      <div class="variant-pills">
        {%- for option in product.options_with_values -%}
          <fieldset class="variant-pills__group">
            <legend>{{ option.name }}</legend>
            {%- for value in option.values -%}
              <label class="pill">
                <input type="radio" name="{{ form_id }}-{{ option.name | handle }}" value="{{ value | escape }}" data-option="{{ forloop.parentloop.index0 }}" {% if option.selected_value == value %}checked{% endif %}>
                <span>{{ value }}</span>
              </label>
            {%- endfor -%}
          </fieldset>
        {%- endfor -%}
        <script type="application/json" data-variants>
          {{ product.variants | json }}
        </script>
      </div>
    {%- endif -%}

    {%- if addon != blank and addon.available and can_buy -%}
      {%- assign addon_variant = addon.selected_or_first_available_variant -%}
      <div class="addon" data-addon>
        <label class="addon__toggle">
          <input type="checkbox" data-addon-toggle value="{{ addon_variant.id }}">
          <span class="addon__check" aria-hidden="true">{% render 'icon', name: 'check', size: 16 %}</span>
          <span class="addon__label">
            {{ section.settings.addon_label | default: 'Add a personalized, author-signed inscription' }}
            <strong class="addon__price">+{{ addon_variant.price | money_without_trailing_zeros }}</strong>
          </span>
          <span class="addon__icon">{% render 'icon', name: 'pencil', size: 20 %}</span>
        </label>
        <div class="addon__field" hidden data-addon-field>
          <label class="visually-hidden" for="{{ form_id }}-inscription">Name for the inscription</label>
          <input
            id="{{ form_id }}-inscription"
            class="input"
            type="text"
            maxlength="60"
            placeholder="{{ section.settings.addon_placeholder | default: 'Child’s name (e.g. “To Emma”)' | escape }}"
            data-addon-name
          >
        </div>
      </div>
    {%- endif -%}

    {%- if can_buy or show_notify == false -%}
    <div class="buy-form__row">
      <div class="qty" data-qty>
        <button type="button" class="qty__btn" data-qty-minus aria-label="Decrease quantity">{% render 'icon', name: 'minus', size: 16 %}</button>
        <input class="qty__input" type="number" name="quantity" value="1" min="1" max="99" aria-label="Quantity" data-qty-input>
        <button type="button" class="qty__btn" data-qty-plus aria-label="Increase quantity">{% render 'icon', name: 'plus', size: 16 %}</button>
      </div>
      <button
        type="submit"
        name="add"
        class="btn btn--primary btn--xl btn--wiggle buy-form__submit"
        data-add-btn
        {% unless can_buy %}disabled{% endunless %}
      >
        <span class="btn__label">
          {%- if can_buy -%}
            {{ section.settings.button_label | default: 'Add to cart' }}
          {%- else -%}
            Sold out
          {%- endif -%}
        </span>
        <span class="btn__spinner" aria-hidden="true"></span>
      </button>
    </div>

    {%- if section.settings.show_buy_now -%}
      <button type="button" class="btn btn--dark btn--block buy-form__buynow" data-buy-now {% unless can_buy %}disabled{% endunless %}>
        {% render 'icon', name: 'lock', size: 18 %} Buy it now
      </button>
    {%- endif -%}

    {%- if section.settings.show_payment_buttons -%}
      <div class="buy-form__dynamic" data-dynamic-checkout>
        {{ form | payment_button }}
      </div>
    {%- endif -%}

    {%- endif -%}

    <p class="buy-form__error" role="alert" hidden data-form-error></p>
  {%- endform -%}
  {%- if show_notify -%}{% render 'notify-me', product: product, form_id: form_id %}{%- endif -%}
</buy-form>
