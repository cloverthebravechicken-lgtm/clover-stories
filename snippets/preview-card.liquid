{%- comment -%}
  Launch preview version of the product card, for a product that's still a draft.
  Usage: {% render 'preview-card', key: 'plush', badge: 'New!' %}
{%- endcomment -%}
{%- capture pv_img -%}{% render 'preview-field', key: key, field: 'image_url' %}{%- endcapture -%}
{%- capture pv_title -%}{% render 'preview-field', key: key, field: 'title' %}{%- endcapture -%}
{%- capture pv_cents -%}{% render 'preview-field', key: key, field: 'cents' %}{%- endcapture -%}
{%- capture pv_compare -%}{% render 'preview-field', key: key, field: 'compare_cents' %}{%- endcapture -%}
{%- liquid
  assign pv_cents = pv_cents | plus: 0
  assign pv_compare = pv_compare | plus: 0
-%}
<div class="pcard card pcard--preview">
  {%- if badge != blank -%}<span class="pcard__badge">{{ badge }}</span>{%- endif -%}
  <span class="pcard__media">
    {%- if pv_img != blank -%}
      <img src="{{ pv_img }}" alt="{{ pv_title }}" width="800" height="800" loading="lazy">
    {%- endif -%}
  </span>
  <div class="pcard__body">
    <span class="pcard__title">{{ pv_title }}</span>
    <span class="price">
      <span class="price__now">{{ pv_cents | money }}</span>
      {%- if pv_compare > pv_cents -%}
        <s class="price__was">{{ pv_compare | money }}</s>
        <span class="price__save">Save {{ pv_compare | minus: pv_cents | money_without_trailing_zeros }}</span>
      {%- endif -%}
    </span>
    <button type="button" class="btn btn--primary btn--block" data-preview-add>Add to cart</button>
  </div>
</div>
