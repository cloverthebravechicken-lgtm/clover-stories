[
  {
    "name": "theme_info",
    "theme_name": "Clover Brave",
    "theme_version": "1.0.0",
    "theme_author": "Clover Stories",
    "theme_documentation_url": "https://cloverstories.com",
    "theme_support_url": "https://cloverstories.com/pages/contact"
  },
  {
    "name": "Brand",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo"
      },
      {
        "type": "range",
        "id": "logo_width",
        "label": "Logo width (desktop)",
        "min": 80,
        "max": 260,
        "step": 4,
        "unit": "px",
        "default": 168
      },
      {
        "type": "range",
        "id": "logo_width_mobile",
        "label": "Logo width (mobile)",
        "min": 60,
        "max": 200,
        "step": 4,
        "unit": "px",
        "default": 120
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon"
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "color_primary",
        "label": "Primary (buttons, accents)",
        "default": "#FF5757"
      },
      {
        "type": "color",
        "id": "color_primary_hover",
        "label": "Primary hover",
        "default": "#FE924E"
      },
      {
        "type": "color",
        "id": "color_primary_shadow",
        "label": "Button shadow",
        "default": "#C62A1E"
      },
      {
        "type": "color",
        "id": "color_green",
        "label": "Farm green",
        "default": "#518339"
      },
      {
        "type": "color",
        "id": "color_sun",
        "label": "Sunshine (stars, highlights)",
        "default": "#FFB800"
      },
      {
        "type": "color",
        "id": "color_sky",
        "label": "Sky background",
        "default": "#EAFBFF"
      },
      {
        "type": "color",
        "id": "color_cream",
        "label": "Cream background",
        "default": "#FFF3ED"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Text",
        "default": "#2B1D14"
      },
      {
        "type": "color",
        "id": "color_text_soft",
        "label": "Secondary text",
        "default": "#736D6B"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "font_heading",
        "label": "Headings",
        "default": "poppins_n8"
      },
      {
        "type": "font_picker",
        "id": "font_body",
        "label": "Body",
        "default": "inter_n4"
      }
    ]
  },
  {
    "name": "Fun & motion",
    "settings": [
      {
        "type": "checkbox",
        "id": "enable_animations",
        "label": "Animate sections on scroll",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "enable_confetti",
        "label": "Feather confetti on add to cart",
        "default": true
      }
    ]
  },
  {
    "name": "Seasonal scene",
    "settings": [
      {
        "type": "paragraph",
        "content": "One switch for the whole site: sets the animated scene in the homepage header (when its Sky is set to “Use the site-wide scene”) and behind the photos on product pages."
      },
      {
        "type": "select",
        "id": "scene",
        "label": "Scene",
        "default": "day",
        "options": [
          {
            "value": "day",
            "label": "Sunny day (summer)"
          },
          {
            "value": "fall",
            "label": "Fall: golden leaves and scarecrow"
          },
          {
            "value": "thanksgiving",
            "label": "Thanksgiving: harvest and a waddling turkey"
          },
          {
            "value": "holiday",
            "label": "Holiday: Christmas night with Santa"
          },
          {
            "value": "winter",
            "label": "Winter: snowfall and a friendly snowman"
          },
          {
            "value": "valentine",
            "label": "Valentine's: floating hearts and tulips"
          },
          {
            "value": "spring",
            "label": "Spring: blossoms, butterflies and tulips"
          },
          {
            "value": "easter",
            "label": "Easter: eggs, chicks and a hopping bunny"
          }
        ]
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "checkbox",
        "id": "cart_drawer",
        "label": "Open cart drawer after add to cart",
        "default": true
      },
      {
        "type": "text",
        "id": "cart_perk_text",
        "label": "Cart perk message",
        "default": "🎉 Free shipping + a free printable activity packet are included!"
      },
      {
        "type": "text",
        "id": "cart_perk_text_plush",
        "label": "Cart perk message when the plush or bundle is in the basket",
        "default": "📦 Your book ships free, and Clover plush ships for a flat $4.99. Plus a free printable activity packet!"
      },
      {
        "type": "checkbox",
        "id": "cart_inscription_upsell",
        "label": "Offer the personalized inscription in the basket",
        "default": true,
        "info": "Shows when the book is in the basket without the inscription. Uses the product and add-on set under Empty basket."
      },
      {
        "type": "text",
        "id": "cart_inscription_heading",
        "label": "Inscription upsell heading",
        "default": "Make it extra special"
      },
      {
        "type": "product",
        "id": "cart_upsell_product",
        "label": "Cart upsell product",
        "info": "Shown in the cart drawer if it isn't already in the cart."
      },
      {
        "type": "text",
        "id": "cart_upsell_heading",
        "label": "Upsell heading",
        "default": "Make storytime extra snuggly"
      },
      {
        "type": "header",
        "content": "Bundle upgrade"
      },
      {
        "type": "paragraph",
        "content": "When the book is in the basket on its own, offer to swap it for the bundle for the difference in price. Replaces the plush upsell while it shows."
      },
      {
        "type": "product",
        "id": "cart_bundle_book",
        "label": "Book"
      },
      {
        "type": "product",
        "id": "cart_bundle_product",
        "label": "Bundle"
      },
      {
        "type": "text",
        "id": "cart_bundle_heading",
        "label": "Heading",
        "default": "Make it the bundle 🎁"
      },
      {
        "type": "text",
        "id": "cart_bundle_text",
        "label": "Text",
        "default": "Add Clover plush for just [diff] more",
        "info": "[diff] is replaced with the price difference."
      },
      {
        "type": "text",
        "id": "cart_bundle_button",
        "label": "Button",
        "default": "Upgrade"
      },
      {
        "type": "text",
        "id": "empty_cart_title",
        "label": "Empty cart title",
        "default": "Your basket is empty… Clover is sad!"
      },
      {
        "type": "text",
        "id": "empty_cart_text",
        "label": "Empty cart text",
        "default": "Free shipping on all books, plus a free 10-page activity packet with every order."
      },
      {
        "type": "header",
        "content": "Empty basket"
      },
      {
        "type": "product",
        "id": "empty_cart_product",
        "label": "Quick-add product when the basket is empty"
      },
      {
        "type": "product",
        "id": "empty_cart_addon",
        "label": "Optional add-on (e.g. personalized & signed)"
      },
      {
        "type": "text",
        "id": "empty_cart_addon_label",
        "label": "Add-on label",
        "default": "Personalize & sign it by the author"
      }
    ]
  },
  {
    "name": "Launch preview",
    "settings": [
      {
        "type": "paragraph",
        "content": "Shows Clover Plush and the Book & Plush Bundle while they're still drafts, so you can see the launch before it happens. Preview only: shoppers can't add them to the cart. Once the products are Active, the real products show instead and these settings are ignored."
      },
      {
        "type": "checkbox",
        "id": "launch_preview",
        "label": "Show plush & bundle preview",
        "default": false
      },
      {
        "type": "text",
        "id": "preview_message",
        "label": "Message when someone tries to add a preview item",
        "default": "Coming soon! Clover's plush isn't for sale just yet. 🐔"
      },
      {
        "type": "header",
        "content": "Clover Plush"
      },
      {
        "type": "image_picker",
        "id": "preview_plush_image",
        "label": "Image"
      },
      {
        "type": "text",
        "id": "preview_plush_title",
        "label": "Title",
        "default": "Clover Plush"
      },
      {
        "type": "text",
        "id": "preview_plush_price",
        "label": "Price",
        "default": "19.99"
      },
      {
        "type": "header",
        "content": "Book & Plush Bundle"
      },
      {
        "type": "image_picker",
        "id": "preview_bundle_image",
        "label": "Image"
      },
      {
        "type": "text",
        "id": "preview_bundle_title",
        "label": "Title",
        "default": "Clover Book & Plush Bundle"
      },
      {
        "type": "text",
        "id": "preview_bundle_price",
        "label": "Price",
        "default": "29.99"
      },
      {
        "type": "text",
        "id": "preview_bundle_compare_price",
        "label": "Compare-at price (for the \"Save\" tag)",
        "default": "36.98"
      }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      {
        "type": "text",
        "id": "social_instagram",
        "label": "Instagram URL"
      },
      {
        "type": "text",
        "id": "social_facebook",
        "label": "Facebook URL"
      },
      {
        "type": "text",
        "id": "social_tiktok",
        "label": "TikTok URL"
      },
      {
        "type": "text",
        "id": "social_pinterest",
        "label": "Pinterest URL"
      }
    ]
  }
]
